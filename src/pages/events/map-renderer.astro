---
import 'maplibre-gl/dist/maplibre-gl.css';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Карта событий</title>
    <script is:inline>
      (() => {
        let theme = '';
        try {
          if (window.parent && window.parent !== window) {
            theme = window.parent.document.documentElement.dataset.theme || '';
          }
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <main class="map-shell" data-map-shell>
      <div class="map-canvas" data-map-canvas aria-label="Карта всех географически привязанных событий"></div>

      <div class="event-range" data-range-control hidden aria-label="Фильтр событий по годам">
        <output data-range-label>Временной интервал: загрузка…</output>
        <div class="event-range__track" data-range-track>
          <input data-range-from type="range" aria-label="Начальный год" />
          <input data-range-to type="range" aria-label="Конечный год" />
        </div>
      </div>

      <div class="map-status" data-map-status hidden aria-live="polite"></div>
      <noscript>Для интерактивной карты требуется JavaScript.</noscript>
    </main>

    <script>
      import maplibregl from 'maplibre-gl';

      type MapTheme = 'dark' | 'light';
      type EventProperties = {
        eventRef: string;
        eventUrl: string;
        eventTitle: string;
        date?: unknown;
        endDate?: unknown;
        startYear?: number | null;
        endYear?: number | null;
        placeRef: string;
        placeLabel: string;
      };
      type EventFeature = {
        type: 'Feature';
        geometry: { type: 'Point'; coordinates: [number, number] };
        properties: EventProperties;
      };
      type EventCollection = { type: 'FeatureCollection'; features: EventFeature[] };
      type PlaceGroup = {
        ref: string;
        label: string;
        coordinates: [number, number];
        events: EventFeature[];
      };

      const root = document.querySelector<HTMLElement>('[data-map-shell]');
      const canvas = document.querySelector<HTMLElement>('[data-map-canvas]');
      const rangeControl = document.querySelector<HTMLElement>('[data-range-control]');
      const rangeTrack = document.querySelector<HTMLElement>('[data-range-track]');
      const rangeFrom = document.querySelector<HTMLInputElement>('[data-range-from]');
      const rangeTo = document.querySelector<HTMLInputElement>('[data-range-to]');
      const rangeLabel = document.querySelector<HTMLOutputElement>('[data-range-label]');
      const status = document.querySelector<HTMLElement>('[data-map-status]');

      if (!root || !canvas || !rangeControl || !rangeTrack || !rangeFrom || !rangeTo || !rangeLabel || !status) {
        throw new Error('Event map renderer is missing required DOM nodes.');
      }

      const mapStyleUrls: Record<MapTheme, string> = {
        dark: 'https://tiles.openfreemap.org/styles/fiord',
        light: 'https://tiles.openfreemap.org/styles/bright',
      };

      function currentTheme(): MapTheme {
        const value = document.documentElement.dataset.theme;
        return value === 'light' ? 'light' : 'dark';
      }

      function formatDateValue(value: unknown): string {
        if (typeof value === 'number') return String(value);
        if (typeof value === 'string') return value;
        if (!value || typeof value !== 'object') return '';
        const date = value as { year?: number; month?: number; day?: number; text?: string };
        if (date.text) return date.text;
        if (!date.year) return '';
        return [date.day, date.month, date.year].filter(Boolean).join('.');
      }

      function eventDateLabel(feature: EventFeature): string {
        const start = formatDateValue(feature.properties.date);
        const end = formatDateValue(feature.properties.endDate);
        return end && end !== start ? `${start || '…'}–${end}` : start;
      }

      function overlaps(feature: EventFeature, from: number, to: number): boolean {
        const start = feature.properties.startYear;
        const end = feature.properties.endYear ?? start;
        if (!Number.isFinite(start) || !Number.isFinite(end)) return false;
        return Number(start) <= to && Number(end) >= from;
      }

      function overviewIcon(): SVGSVGElement {
        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        svg.setAttribute('viewBox', '0 0 24 24');
        svg.setAttribute('aria-hidden', 'true');
        svg.classList.add('rslive-map-overview-icon');
        for (const [cx, cy, radius] of [[7, 8, 2.2], [16.5, 7, 1.8], [13, 16, 2.4]]) {
          const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          circle.setAttribute('cx', String(cx));
          circle.setAttribute('cy', String(cy));
          circle.setAttribute('r', String(radius));
          svg.append(circle);
        }
        return svg;
      }

      class HomeControl {
        private map?: maplibregl.Map;
        private container?: HTMLDivElement;
        private button?: HTMLButtonElement;
        private readonly onOverview: () => void;

        constructor(onOverview: () => void) {
          this.onOverview = onOverview;
        }

        onAdd(controlMap: maplibregl.Map) {
          this.map = controlMap;
          this.container = document.createElement('div');
          this.container.className = 'maplibregl-ctrl maplibregl-ctrl-group';
          this.button = document.createElement('button');
          this.button.type = 'button';
          this.button.className = 'rslive-map-home';
          this.button.title = 'Показать все события';
          this.button.setAttribute('aria-label', 'Показать все события');
          this.button.append(overviewIcon());
          this.button.addEventListener('click', this.onOverview);
          this.container.append(this.button);
          return this.container;
        }

        onRemove() {
          this.button?.removeEventListener('click', this.onOverview);
          this.container?.remove();
          this.map = undefined;
        }
      }

      function collapseAttribution() {
        const control = root.querySelector('.maplibregl-ctrl-attrib');
        if (!(control instanceof HTMLElement)) return;
        control.classList.add('maplibregl-compact');
        control.classList.remove('maplibregl-compact-show');
        const button = control.querySelector('.maplibregl-ctrl-attrib-button');
        if (button instanceof HTMLElement) button.setAttribute('aria-expanded', 'false');
      }

      const response = await fetch('/generated/places.geojson');
      if (!response.ok) {
        status.hidden = false;
        status.classList.add('error');
        status.textContent = 'Не удалось загрузить данные карты.';
        throw new Error(`Failed to load event map data: ${response.status}`);
      }

      const dataset = await response.json() as EventCollection;
      const datedFeatures = (dataset.features ?? []).filter((feature) => Number.isFinite(feature.properties.startYear));
      const years = datedFeatures.flatMap((feature) => [
        Number(feature.properties.startYear),
        Number(feature.properties.endYear ?? feature.properties.startYear),
      ]).filter(Number.isFinite);

      if (!years.length) {
        status.hidden = false;
        status.textContent = 'Нет датированных событий для отображения.';
        throw new Error('Event map has no dated features.');
      }

      const datasetMin = Math.min(...years);
      const datasetMax = Math.max(...years);
      let selectedFrom = datasetMin;
      let selectedTo = datasetMax;
      let theme = currentTheme();
      const markers: maplibregl.Marker[] = [];

      for (const input of [rangeFrom, rangeTo]) {
        input.min = String(datasetMin);
        input.max = String(datasetMax);
        input.step = '1';
      }
      rangeFrom.value = String(datasetMin);
      rangeTo.value = String(datasetMax);
      rangeControl.hidden = false;

      const map = new maplibregl.Map({
        container: canvas,
        style: mapStyleUrls[theme],
        center: [30, 52],
        zoom: 2.5,
        attributionControl: false,
        renderWorldCopies: false,
      });

      function filteredFeatures() {
        return datedFeatures.filter((feature) => overlaps(feature, selectedFrom, selectedTo));
      }

      function placeGroups(): PlaceGroup[] {
        const groups = new Map<string, PlaceGroup>();
        for (const feature of filteredFeatures()) {
          const ref = feature.properties.placeRef;
          const existing = groups.get(ref) ?? {
            ref,
            label: feature.properties.placeLabel,
            coordinates: feature.geometry.coordinates,
            events: [],
          };
          existing.events.push(feature);
          groups.set(ref, existing);
        }
        return [...groups.values()].sort((a, b) => a.label.localeCompare(b.label, 'ru'));
      }

      function popupFor(group: PlaceGroup) {
        const wrapper = document.createElement('div');
        wrapper.className = 'rslive-map-popup';

        const name = document.createElement('strong');
        name.textContent = group.label;
        wrapper.append(name);

        const list = document.createElement('div');
        list.className = 'rslive-map-popup-events';
        for (const feature of group.events) {
          const row = document.createElement('div');
          row.className = 'rslive-map-popup-event';

          const date = eventDateLabel(feature);
          if (date) {
            const time = document.createElement('span');
            time.className = 'rslive-map-popup-event-date';
            time.textContent = date;
            row.append(time);
          }

          const link = document.createElement('a');
          link.href = feature.properties.eventUrl;
          link.target = '_top';
          link.textContent = feature.properties.eventTitle;
          row.append(link);
          list.append(row);
        }
        wrapper.append(list);
        return wrapper;
      }

      function clearMarkers() {
        while (markers.length) markers.pop()?.remove();
      }

      function renderMarkers() {
        clearMarkers();
        for (const group of placeGroups()) {
          const marker = new maplibregl.Marker()
            .setLngLat(group.coordinates)
            .setPopup(new maplibregl.Popup({ maxWidth: 'min(22rem, 80vw)', offset: 24 }).setDOMContent(popupFor(group)))
            .addTo(map);
          markers.push(marker);
        }
      }

      function fitOverview(animate = true) {
        const groups = placeGroups();
        if (!groups.length) return;
        if (groups.length === 1) {
          map.easeTo({ center: groups[0].coordinates, zoom: Math.min(map.getMaxZoom(), 12.2), duration: animate ? 350 : 0 });
          return;
        }
        const bounds = new maplibregl.LngLatBounds();
        for (const group of groups) bounds.extend(group.coordinates);
        map.fitBounds(bounds, {
          padding: { top: 82, right: 48, bottom: 58, left: 48 },
          maxZoom: Math.min(map.getMaxZoom(), 12.2),
          duration: animate ? 350 : 0,
        });
      }

      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
      map.addControl(new HomeControl(() => fitOverview(true)), 'top-right');
      map.addControl(new maplibregl.FullscreenControl({ container: root }), 'top-right');
      map.addControl(new maplibregl.GeolocateControl({
        positionOptions: { enableHighAccuracy: true },
        trackUserLocation: true,
      }), 'top-right');
      map.addControl(new maplibregl.ScaleControl({ maxWidth: 90, unit: 'metric' }), 'bottom-left');
      map.addControl(new maplibregl.AttributionControl({ compact: true }), 'bottom-right');

      function updateRange() {
        let from = Number(rangeFrom.value);
        let to = Number(rangeTo.value);
        if (from > to) {
          if (document.activeElement === rangeFrom) to = from;
          else from = to;
          rangeFrom.value = String(from);
          rangeTo.value = String(to);
        }
        selectedFrom = from;
        selectedTo = to;
        rangeLabel.value = `Временной интервал: ${from === to ? from : `${from}–${to}`}`;

        const span = Math.max(1, datasetMax - datasetMin);
        rangeTrack.style.setProperty('--range-from', `${((from - datasetMin) / span) * 100}%`);
        rangeTrack.style.setProperty('--range-to', `${((to - datasetMin) / span) * 100}%`);
        renderMarkers();
      }

      rangeFrom.addEventListener('input', updateRange);
      rangeTo.addEventListener('input', updateRange);

      map.on('load', () => {
        updateRange();
        collapseAttribution();
        fitOverview(false);
      });
      map.once('idle', collapseAttribution);

      const parentDocument = (() => {
        try {
          return window.parent && window.parent !== window ? window.parent.document : null;
        } catch {
          return null;
        }
      })();

      const syncTheme = () => {
        let next: MapTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const parentValue = parentDocument?.documentElement.dataset.theme;
        if (parentValue === 'light' || parentValue === 'dark') next = parentValue;
        if (next === theme) return;
        theme = next;
        document.documentElement.dataset.theme = next;
        map.setStyle(mapStyleUrls[next]);
        map.once('style.load', collapseAttribution);
      };

      const parentObserver = parentDocument ? new MutationObserver(syncTheme) : null;
      parentObserver?.observe(parentDocument.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncTheme);
    </script>
  </body>
</html>

<style is:global>
  :root {
    --map-popup-bg: #ffffff;
    --map-popup-fg: #1f2937;
    --map-panel-bg: rgb(255 255 255 / 92%);
    --map-panel-fg: #1f2937;
    --map-panel-muted: #64748b;
    --map-panel-border: rgb(148 163 184 / 42%);
    --map-control-bg: #ffffff;
    --map-control-hover: #f1f5f9;
    --map-control-fg: #1f2937;
    --map-control-border: #d7dde4;
    --map-link: #1d4ed8;
    --map-range-track: #cbd5e1;
    --map-range-active: #2563eb;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color-scheme: light;
  }

  html[data-theme='dark'] {
    --map-popup-bg: #1f2937;
    --map-popup-fg: #e5e7eb;
    --map-panel-bg: rgb(23 33 41 / 92%);
    --map-panel-fg: #e5e7eb;
    --map-panel-muted: #aab4bd;
    --map-panel-border: rgb(100 116 139 / 50%);
    --map-control-bg: #1f2937;
    --map-control-hover: #334155;
    --map-control-fg: #e5e7eb;
    --map-control-border: #475569;
    --map-link: #93c5fd;
    --map-range-track: #475569;
    --map-range-active: #60a5fa;
    color-scheme: dark;
  }

  * { box-sizing: border-box; }
  html, body, .map-shell, .map-canvas { width: 100%; height: 100%; min-height: 100%; margin: 0; }
  html, body { min-height: 100vh; }
  body { overflow: hidden; }
  .map-shell { position: relative; overflow: hidden; background: #f5f2ea; }
  html[data-theme='dark'] .map-shell { background: #172129; }
  .map-canvas { position: absolute; inset: 0; }

  .event-range {
    position: absolute;
    z-index: 8;
    top: max(0.65rem, env(safe-area-inset-top));
    left: 0;
    width: min(72vw, 30rem);
    padding: 0.55rem 0.8rem 0.62rem max(0.8rem, calc(env(safe-area-inset-left) + 0.4rem));
    border: 1px solid var(--map-panel-border);
    border-left: 0;
    border-radius: 0 0.7rem 0.7rem 0;
    background: var(--map-panel-bg);
    box-shadow: 0 4px 18px rgb(15 23 42 / 14%);
    color: var(--map-panel-fg);
    backdrop-filter: blur(8px);
  }
  .event-range[hidden] { display: none; }
  .event-range output {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.8rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }
  .event-range__track {
    --range-from: 0%;
    --range-to: 100%;
    position: relative;
    height: 1.25rem;
  }
  .event-range__track::before {
    content: '';
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: 4px;
    transform: translateY(-50%);
    border-radius: 999px;
    background: linear-gradient(to right,
      var(--map-range-track) 0 var(--range-from),
      var(--map-range-active) var(--range-from) var(--range-to),
      var(--map-range-track) var(--range-to) 100%);
  }
  .event-range__track input[type='range'] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 1.25rem;
    margin: 0;
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    pointer-events: none;
  }
  .event-range__track input[type='range']::-webkit-slider-runnable-track { height: 4px; background: transparent; }
  .event-range__track input[type='range']::-moz-range-track { height: 4px; background: transparent; }
  .event-range__track input[type='range']::-moz-range-progress { background: transparent; }
  .event-range__track input[type='range']::-webkit-slider-thumb {
    width: 18px;
    height: 18px;
    margin-top: -7px;
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    border-radius: 999px;
    background: var(--map-range-active);
    box-shadow: 0 1px 3px rgb(15 23 42 / 32%);
    pointer-events: auto;
  }
  .event-range__track input[type='range']::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border: 0;
    border-radius: 999px;
    background: var(--map-range-active);
    box-shadow: 0 1px 3px rgb(15 23 42 / 32%);
    pointer-events: auto;
  }

  .map-status {
    position: absolute;
    z-index: 9;
    left: 50%;
    top: 50%;
    max-width: calc(100% - 2rem);
    transform: translate(-50%, -50%);
    padding: 0.62rem 0.8rem;
    border: 1px solid var(--map-panel-border);
    border-radius: 0.65rem;
    background: var(--map-panel-bg);
    box-shadow: 0 4px 16px rgb(15 23 42 / 12%);
    color: var(--map-panel-fg);
    font-size: 0.82rem;
  }
  .map-status[hidden] { display: none; }
  .map-status.error { color: #991b1b; }
  html[data-theme='dark'] .map-status.error { color: #fecaca; }

  .maplibregl-popup { max-width: min(22rem, 80vw) !important; }
  .maplibregl-popup-content {
    max-height: min(32rem, calc(100dvh - 5rem));
    overflow-y: auto;
    border: 1px solid var(--map-panel-border);
    border-radius: 0.65rem;
    background: var(--map-popup-bg);
    color: var(--map-popup-fg);
    box-shadow: 0 5px 20px rgb(15 23 42 / 24%);
  }
  .maplibregl-popup-anchor-top .maplibregl-popup-tip,
  .maplibregl-popup-anchor-top-left .maplibregl-popup-tip,
  .maplibregl-popup-anchor-top-right .maplibregl-popup-tip { border-bottom-color: var(--map-popup-bg); }
  .maplibregl-popup-anchor-bottom .maplibregl-popup-tip,
  .maplibregl-popup-anchor-bottom-left .maplibregl-popup-tip,
  .maplibregl-popup-anchor-bottom-right .maplibregl-popup-tip { border-top-color: var(--map-popup-bg); }
  .maplibregl-popup-anchor-left .maplibregl-popup-tip { border-right-color: var(--map-popup-bg); }
  .maplibregl-popup-anchor-right .maplibregl-popup-tip { border-left-color: var(--map-popup-bg); }
  .maplibregl-popup-close-button { padding: 0.25rem 0.5rem; color: var(--map-popup-fg); font-size: 1.15rem; }

  .rslive-map-popup { display: grid; gap: 0.42rem; min-width: min(15rem, 70vw); }
  .rslive-map-popup strong { padding-right: 1rem; font-size: 0.92rem; line-height: 1.2; }
  .rslive-map-popup-events { display: grid; gap: 0.45rem; }
  .rslive-map-popup-event { display: grid; gap: 0.08rem; }
  .rslive-map-popup-event + .rslive-map-popup-event { padding-top: 0.42rem; border-top: 1px solid var(--map-panel-border); }
  .rslive-map-popup-event-date { color: var(--map-panel-muted); font-size: 0.72rem; line-height: 1.25; }
  .rslive-map-popup a { color: var(--map-link); font-size: 0.78rem; line-height: 1.3; text-decoration: none; }
  .rslive-map-popup a:hover { text-decoration: underline; }

  .maplibregl-ctrl-top-right { top: max(0.45rem, env(safe-area-inset-top)); right: max(0.4rem, env(safe-area-inset-right)); }
  .maplibregl-ctrl-group {
    overflow: hidden;
    border: 1px solid var(--map-control-border);
    border-radius: 0.55rem;
    background: var(--map-control-bg) !important;
    box-shadow: 0 2px 9px rgb(15 23 42 / 16%);
  }
  .maplibregl-ctrl-group button { background-color: var(--map-control-bg) !important; color: var(--map-control-fg) !important; }
  .maplibregl-ctrl-group button:hover,
  .maplibregl-ctrl-group button:focus-visible { background-color: var(--map-control-hover) !important; }
  .maplibregl-ctrl-group button + button { border-top-color: var(--map-control-border) !important; }
  .rslive-map-home { display: grid !important; place-items: center; }
  .rslive-map-overview-icon { width: 20px; height: 20px; fill: currentColor; }
  html[data-theme='dark'] .maplibregl-ctrl-group .maplibregl-ctrl-icon,
  html[data-theme='dark'] .maplibregl-ctrl-attrib-button { filter: invert(1) brightness(1.35); }

  .maplibregl-ctrl-bottom-right { left: 0; right: auto; }
  .maplibregl-ctrl-bottom-right .maplibregl-ctrl-attrib {
    margin: 0 0 max(0.55rem, env(safe-area-inset-bottom)) max(0.55rem, env(safe-area-inset-left));
  }
  .maplibregl-ctrl-attrib {
    border: 1px solid var(--map-control-border);
    background: color-mix(in srgb, var(--map-control-bg) 92%, transparent) !important;
    color: var(--map-control-fg);
    backdrop-filter: blur(8px);
  }
  .maplibregl-ctrl-attrib a { color: var(--map-link); }
  .maplibregl-ctrl-bottom-left .maplibregl-ctrl-scale {
    max-width: 4.6rem !important;
    margin: 0 0 max(0.55rem, env(safe-area-inset-bottom)) max(3.15rem, calc(env(safe-area-inset-left) + 3.15rem)) !important;
    padding: 0 0.28rem !important;
    border-color: var(--map-control-fg) !important;
    border-width: 1px !important;
    border-top-width: 0 !important;
    background: color-mix(in srgb, var(--map-control-bg) 58%, transparent) !important;
    color: var(--map-control-fg) !important;
    font-size: 0.64rem !important;
    line-height: 1.2 !important;
    opacity: 0.82;
  }
  .maplibregl-ctrl-attrib.maplibregl-compact:not(.maplibregl-compact-show) .maplibregl-ctrl-attrib-inner { display: none !important; }

  .map-shell:fullscreen,
  .map-shell:-webkit-full-screen { width: 100vw; height: 100vh; min-height: 100vh; }

  @media (max-width: 40rem) {
    .event-range { width: min(68vw, 22rem); }
  }
</style>
