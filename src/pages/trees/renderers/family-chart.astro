<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Family Chart</title>
    <link rel="stylesheet" href="/tree/renderer.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/family-chart@0.9.0/dist/styles/family-chart.css" />
    <script src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js"></script>
    <style is:global>
      #FamilyChart { width:100%; height:100%; }
      #FamilyChart .card_cont { overflow:visible; filter:none !important; }
      #FamilyChart path.link { stroke:var(--tree-edge) !important; stroke-width:1.35px; }
      #FamilyChart div.card, #FamilyChart div.card.card-male, #FamilyChart div.card.card-female,
      #FamilyChart div.card.card-genderless, #FamilyChart div.card-inner, #FamilyChart .genealogy-card-host {
        width:240px !important; height:108px !important; min-height:108px !important; margin:0 !important;
        padding:0 !important; border:0 !important; border-radius:0 !important; outline:0 !important;
        background:transparent !important; box-shadow:none !important; filter:none !important; color:inherit !important;
      }
      #FamilyChart div.card::before, #FamilyChart div.card::after,
      #FamilyChart div.card-inner::before, #FamilyChart div.card-inner::after { display:none !important; content:none !important; }
    </style>
  </head>
  <body>
    <main class="tree-shell">
      <div id="FamilyChart" class="tree-canvas f3"></div>
      <div id="status" class="tree-status">Загрузка Family Chart…</div>
    </main>
    <script type="module" is:inline>
      import * as f3 from 'https://esm.sh/family-chart@0.9.0';
      import { toFamilyChartData } from '/tree/renderer-adapters.js';
      import { personCardElementHtml } from '/tree/person-card.js';
      import { startThemeBridge } from '/tree/theme-bridge.js';
      import { scopeTreeDataset, treeRenderContext, reportTreeScope } from '/tree/scope.js';

      startThemeBridge();
      const status = document.getElementById('status');
      try {
        const response = await fetch('/generated/tree.json');
        if (!response.ok) throw new Error(`tree.json: ${response.status}`);
        const sourceFamily = await response.json();
        const context = treeRenderContext();
        const family = scopeTreeDataset(sourceFamily, context.person, context.depth);
        const focusId = family.focus || family.people[0]?.id;
        reportTreeScope(family);

        const data = toFamilyChartData(family);
        const chart = f3.createChart('#FamilyChart', data)
          .setTransitionTime(0)
          .setCardXSpacing(286)
          .setCardYSpacing(148);
        chart.setCardHtml().setCardInnerHtmlCreator((d) => {
          const p = d.data.data;
          const sourceName = [p['first name'], p['last name']].filter(Boolean).join(' ');
          return `<div class="card-inner genealogy-card-host">${personCardElementHtml({
            id:d.data.id, url:p.url || '', name:sourceName, cardName:p.cardName || '', birthSurname:p.birthSurname || '',
            marriedSurname:p.marriedSurname || '', years:p.years || '', sex:p.sex || p.gender || '',
            deceased:Boolean(p.deceased), photo:p.photo || ''
          })}</div>`;
        });
        chart.updateTree({ initial:true, main_id:focusId });
        const total = family.scope?.totalPeople || family.summary.people;
        status.textContent = `Family Chart · ${family.summary.people} из ${total} людей`;
      } catch (error) {
        console.error(error);
        status.textContent = `Family Chart: ${error?.message || error}`;
        status.classList.add('error');
      }
    </script>
  </body>
</html>
