<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Family Chart</title>
    <link rel="stylesheet" href="/tree/renderer.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/family-chart@0.9.0/dist/styles/family-chart.css" />
    <style is:global>
      #FamilyChart { width:100%; height:100%; background:var(--tree-background); }
      #FamilyChart .card_cont { overflow:visible; filter:none !important; }
      #FamilyChart path.link { stroke:var(--tree-edge) !important; stroke-width:1.35px; }
      #FamilyChart div.card, #FamilyChart div.card.card-male, #FamilyChart div.card.card-female,
      #FamilyChart div.card.card-genderless, #FamilyChart div.card-inner, #FamilyChart .genealogy-card-host {
        width:240px !important; height:108px !important; min-height:108px !important; margin:0 !important;
        padding:0 !important; border:0 !important; border-radius:0 !important; outline:0 !important;
        background:transparent !important; box-shadow:none !important; filter:none !important; color:inherit !important;
        overflow:visible !important;
      }
      #FamilyChart div.card::before, #FamilyChart div.card::after,
      #FamilyChart div.card-inner::before, #FamilyChart div.card-inner::after { display:none !important; content:none !important; }
    </style>
  </head>
  <body>
    <main class="tree-shell">
      <div id="FamilyChart" class="tree-canvas f3"></div>
      <div id="status" class="tree-status">Загрузка семейного дерева…</div>
    </main>
    <script type="module" is:inline>
      import * as f3 from 'https://esm.sh/family-chart@0.9.0';
      import { toFamilyChartData } from '/tree/renderer-adapters.js';
      import { personCardElementHtml } from '/tree/person-card.js';
      import { renderRelationSvg } from '/tree/relation-ui.js';
      import { startThemeBridge } from '/tree/theme-bridge.js';
      import { createTreeExpansionState, treeRenderContext, reportTreeScope, renderTreeStatus } from '/tree/scope.js';

      startThemeBridge();
      const status = document.getElementById('status');
      const canvas = document.getElementById('FamilyChart');
      let chart = null;
      let layoutFocusId = '';
      let focusId = '';
      let focusName = '';
      let expansion = null;
      let renderVersion = 0;

      try {
        const response = await fetch('/generated/tree.json');
        if (!response.ok) throw new Error(`tree.json: ${response.status}`);
        const sourceFamily = await response.json();
        const context = treeRenderContext();
        const overviewMode = context.overviewMode;
        expansion = createTreeExpansionState(sourceFamily, context.person);
        layoutFocusId = expansion.focusId;
        focusId = overviewMode ? '' : layoutFocusId;
        const focusPerson = sourceFamily.people?.find((person) => person.id === focusId);
        focusName = focusPerson?.cardName || focusPerson?.name || focusId || 'Семейное дерево';

        const centerOnPerson = (id = layoutFocusId, transitionTime = 220) => {
          if (!chart || !id) return;
          const datum = chart.store.getTree()?.data?.find((item) => item?.data?.id === id || item?.id === id);
          if (!datum) return;
          f3.handlers.cardToMiddle({
            datum,
            svg:chart.svg,
            svg_dim:chart.svg.getBoundingClientRect(),
            transition_time:transitionTime,
          });
        };

        const centerOnFocus = () => {
          if (!overviewMode) centerOnPerson(focusId);
        };

        const renderFamily = (family, { anchorId = layoutFocusId, fit = false } = {}) => {
          const version = ++renderVersion;
          const startedAt = performance.now();
          const data = toFamilyChartData(family);
          canvas.replaceChildren();

          chart = f3.createChart('#FamilyChart', data)
            .setTransitionTime(0)
            .setCardXSpacing(286)
            .setCardYSpacing(148);

          chart.setCardHtml()
            .setCardInnerHtmlCreator((d) => {
              const p = d.data.data;
              const sourceName = [p['first name'], p['last name']].filter(Boolean).join(' ');
              return `<div class="card-inner genealogy-card-host">${personCardElementHtml({
                id:d.data.id, url:p.url || '', name:sourceName, cardName:p.cardName || '', birthSurname:p.birthSurname || '',
                marriedSurname:p.marriedSurname || '', years:p.years || '', sex:p.sex || p.gender || '',
                deceased:Boolean(p.deceased), photo:p.photo || ''
              }, { branchState:expansion.branchState(d.data.id) })}</div>`;
            })
            .setOnCardClick((event, datum) => {
              const id = datum?.data?.id || datum?.id;
              if (!id || !expansion) return;
              event?.preventDefault?.();
              event?.stopPropagation?.();
              renderFamily(expansion.toggle(id), { anchorId:id });
            });

          chart.updateTree({ initial:true, main_id:layoutFocusId });
          reportTreeScope(family);
          const total = sourceFamily.people?.length || family.summary.people;
          renderTreeStatus(status, {
            focusName,
            visiblePeople:family.summary.people,
            totalPeople:total,
            onFocus:overviewMode ? undefined : centerOnFocus,
            onExpandAll:overviewMode ? undefined : expandAll,
            overviewMode,
          });
          const elapsed = Math.round(performance.now() - startedAt);
          status.title = `Family Chart · построение ${elapsed} мс · ${family.summary.people} человек`;
          status.dataset.renderMs = String(elapsed);

          requestAnimationFrame(() => requestAnimationFrame(() => {
            if (version !== renderVersion || !chart) return;
            renderRelationSvg(canvas, family);
            if (fit || overviewMode) chart.updateTree({ tree_position:'fit', transition_time:220 });
            else centerOnPerson(anchorId, 0);
          }));
        };

        const expandAll = () => renderFamily(expansion.expandAll(), { fit:true });

        window.addEventListener('genealogy:toggle-person', (event) => {
          const id = event.detail;
          if (!id || !expansion) return;
          renderFamily(expansion.toggle(id), { anchorId:id });
        });

        window.addEventListener('message', (event) => {
          if (event.origin !== window.location.origin || event.source !== window.parent || !chart) return;
          if (event.data?.type !== 'genealogy:tree-command') return;
          switch (event.data.command) {
            case 'zoom-in':
              f3.handlers.manualZoom({ amount:1.2, svg:chart.svg, transition_time:180 });
              break;
            case 'zoom-out':
              f3.handlers.manualZoom({ amount:0.8, svg:chart.svg, transition_time:180 });
              break;
            case 'fit':
              chart.updateTree({ tree_position:'fit', transition_time:220 });
              break;
            case 'focus':
              if (!overviewMode) centerOnFocus();
              break;
            case 'expand-all':
              expandAll();
              break;
          }
        });

        if (overviewMode) expandAll();
        else renderFamily(expansion.snapshot());
      } catch (error) {
        console.error(error);
        status.textContent = `Family Chart: ${error?.message || error}`;
        status.classList.add('error');
      }
    </script>
  </body>
</html>
