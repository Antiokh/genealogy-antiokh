<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Vue Flow + ELK</title>
    <link rel="stylesheet" href="/tree/renderer.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@vue-flow/core@1.48.2/dist/style.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@vue-flow/core@1.48.2/dist/theme-default.css" />
    <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@vue-flow/core@1.48.2/dist/vue-flow-core.iife.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/elkjs@0.12.0/lib/elk.bundled.js"></script>
    <style is:global>
      #app, .vue-flow { width:100%; height:100%; }
      .vue-flow { background:var(--sl-color-bg); color:var(--sl-color-text); }
      .vue-flow__node-person, .vue-flow__node-family { border:0; background:transparent; padding:0; box-shadow:none; }
      .vue-flow__node-person { width:240px; height:108px; }
      .vue-flow__node-family { width:18px; height:18px; }
      .vue-flow__handle { width:1px !important; height:1px !important; min-width:1px; min-height:1px; opacity:0; border:0; }
      .vue-flow__edge-path { stroke:var(--tree-edge); stroke-width:1.35; }
      .person-node-wrap { width:240px; height:108px; position:relative; }
      .union-wrap { width:18px; height:18px; position:relative; display:grid; place-items:center; }
    </style>
  </head>
  <body>
    <main class="tree-shell">
      <div id="app" class="tree-canvas"></div>
      <div id="status" class="tree-status">Раскладка Vue Flow + ELK…</div>
    </main>
    <script type="module" is:inline>
      // @ts-nocheck
      import { toVueFlowElkData } from '/tree/renderer-adapters.js';
      import { personCardElementHtml, PERSON_CARD_WIDTH, PERSON_CARD_HEIGHT } from '/tree/person-card.js';
      import { startThemeBridge } from '/tree/theme-bridge.js';

      startThemeBridge();
      const status = document.getElementById('status');
      try {
        const response = await fetch('/generated/tree.json');
        if (!response.ok) throw new Error(`tree.json: ${response.status}`);
        const family = await response.json();
        const { createApp, ref } = window.Vue;
        const { VueFlow, Handle, Position } = window.VueFlowCore;
        const elk = new window.ELK();
        const { nodes:rawNodes, edges:rawEdges } = toVueFlowElkData(family, {
          personWidth:PERSON_CARD_WIDTH, personHeight:PERSON_CARD_HEIGHT
        });
        const graph = await elk.layout({
          id:'root',
          layoutOptions:{
            'elk.algorithm':'layered', 'elk.direction':'DOWN', 'elk.spacing.nodeNode':'36',
            'elk.layered.spacing.nodeNodeBetweenLayers':'96', 'elk.edgeRouting':'ORTHOGONAL',
            'elk.layered.considerModelOrder.strategy':'NODES_AND_EDGES'
          },
          children:rawNodes.map((n) => ({ id:n.id, width:n.width, height:n.height })),
          edges:rawEdges.map((e) => ({ id:e.id, sources:[e.source], targets:[e.target] }))
        });
        const positions = Object.fromEntries(graph.children.map((n) => [n.id, { x:n.x || 0, y:n.y || 0 }]));
        const nodes = ref(rawNodes.map((n) => ({ id:n.id, type:n.type, data:n.data, position:positions[n.id] })));
        const edges = ref(rawEdges.map((e) => ({ ...e, type:'smoothstep', style:{ stroke:'var(--tree-edge)', strokeWidth:1.35 } })));
        createApp({
          components:{ VueFlow, Handle },
          setup() { return { nodes, edges, Position, personCardElementHtml }; },
          template:`
            <vue-flow :nodes="nodes" :edges="edges" :fit-view-on-init="true" :min-zoom="0.08" :max-zoom="2" :nodes-draggable="false">
              <template #node-person="{ data }">
                <div class="person-node-wrap">
                  <handle type="target" :position="Position.Top"></handle>
                  <div v-html="personCardElementHtml(data)"></div>
                  <handle type="source" :position="Position.Bottom"></handle>
                </div>
              </template>
              <template #node-family="{ data }">
                <div class="union-wrap">
                  <handle type="target" :position="Position.Top"></handle>
                  <div class="union-dot"></div>
                  <div v-if="data.label" class="union-label">{{ data.label }}</div>
                  <handle type="source" :position="Position.Bottom"></handle>
                </div>
              </template>
            </vue-flow>`
        }).mount('#app');
        status.textContent = `Vue Flow + ELK · ${family.summary.people} людей · ${family.summary.families} союзов`;
      } catch (error) {
        console.error(error);
        status.textContent = `Vue Flow + ELK: ${error?.message || error}`;
        status.classList.add('error');
      }
    </script>
  </body>
</html>
