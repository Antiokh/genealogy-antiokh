---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import 'photoswipe/style.css';

interface Props {
  personRef: string;
}

const { personRef } = Astro.props;
const docs = await getCollection('docs');

function subjectMatches(value: unknown): boolean {
  if (typeof value === 'string') return value === personRef;
  if (!value || typeof value !== 'object' || !('person' in value)) return false;
  return (value as { person?: string }).person === personRef;
}

function dateKey(value: unknown): number {
  if (typeof value === 'number') return value * 10000;
  if (typeof value === 'string') {
    const match = value.match(/^(\d{4})(?:-(\d{2}))?(?:-(\d{2}))?/);
    if (match) return Number(match[1]) * 10000 + Number(match[2] ?? 0) * 100 + Number(match[3] ?? 0);
  }
  if (value && typeof value === 'object' && 'year' in value) {
    const item = value as { year?: number; month?: number; day?: number };
    if (item.year) return item.year * 10000 + (item.month ?? 0) * 100 + (item.day ?? 0);
  }
  return Number.MAX_SAFE_INTEGER;
}

function dateLabel(value: unknown): string | undefined {
  if (typeof value === 'number') return String(value);
  if (typeof value === 'string') return value;
  if (value && typeof value === 'object') {
    const item = value as { year?: number; month?: number; day?: number; text?: string; circa?: boolean };
    if (item.text) return item.text;
    if (!item.year) return undefined;
    const result = [item.day, item.month, item.year].filter(Boolean).join('.');
    return item.circa ? `ок. ${result}` : result;
  }
  return undefined;
}

const media = docs
  .filter((entry) => entry.data.entity === 'media' && entry.data.image && entry.data.subjects?.some(subjectMatches))
  .sort((a, b) => dateKey(a.data.date) - dateKey(b.data.date) || a.data.title.localeCompare(b.data.title, 'ru'));
---

{media.length > 0 && (
  <section class="person-gallery-section" aria-labelledby="person-gallery-heading">
    <h2 id="person-gallery-heading">Фотографии</h2>
    <div class="person-gallery" data-pswp-gallery>
      {media.map((entry) => {
        const image = entry.data.image;
        if (!image) return null;
        const isRemote = typeof image === 'string';
        const src = isRemote ? image : image.src;
        const width = isRemote ? entry.data.width : image.width;
        const height = isRemote ? entry.data.height : image.height;
        const canLightbox = Boolean(width && height);
        const caption = entry.data.caption || entry.data.title;
        const date = dateLabel(entry.data.date);
        const alt = entry.data.alt || caption;
        const orientation = width && height && height > width ? 'portrait' : 'landscape';

        return (
          <figure class="person-gallery-item">
            <a
              class="person-gallery-mount"
              href={src}
              data-pswp-width={canLightbox ? width : undefined}
              data-pswp-height={canLightbox ? height : undefined}
              data-pswp-caption={canLightbox ? caption : undefined}
              target={canLightbox ? undefined : '_blank'}
              rel={canLightbox ? undefined : 'noreferrer'}
              aria-label={`Открыть: ${caption}`}
            >
              <svg
                class="person-gallery-mount-cross"
                viewBox="0 0 100 100"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M42 7h16v29h29v28H58v29H42V64H13V36h29Z" />
              </svg>
              <span class:list={['person-gallery-window', `is-${orientation}`]}>
                {isRemote ? (
                  <img class="person-gallery-photo" src={src} alt={alt} loading="lazy" decoding="async" />
                ) : (
                  <Image
                    class="person-gallery-photo"
                    src={image}
                    alt={alt}
                    widths={[320, 480, 720]}
                    sizes="(max-width: 36rem) 45vw, (max-width: 72rem) 32vw, 260px"
                    loading="lazy"
                  />
                )}
              </span>
            </a>
            <figcaption>
              <span title={caption}>{caption}</span>
              {date && <time>{date}</time>}
            </figcaption>
          </figure>
        );
      })}
    </div>
  </section>
)}

<script>
  async function initPhotoSwipe() {
    const galleries = [...document.querySelectorAll<HTMLElement>('[data-pswp-gallery]')]
      .filter((gallery) => gallery.dataset.pswpReady !== 'true' && gallery.querySelector('a[data-pswp-width]'));
    if (!galleries.length) return;

    const { default: PhotoSwipeLightbox } = await import('photoswipe/lightbox');

    for (const gallery of galleries) {
      const lightbox = new PhotoSwipeLightbox({
        gallery,
        children: 'a[data-pswp-width]',
        pswpModule: () => import('photoswipe'),
        wheelToZoom: true,
        bgOpacity: 0.94,
      });

      let hasHistoryEntry = false;
      let closingFromHistory = false;

      const onPopState = () => {
        if (!hasHistoryEntry || !lightbox.pswp) return;
        hasHistoryEntry = false;
        closingFromHistory = true;
        lightbox.pswp.close();
      };

      lightbox.on('beforeOpen', () => {
        if (hasHistoryEntry) return;
        history.pushState(
          { ...(history.state ?? {}), genealogyLightbox: true },
          '',
          window.location.href,
        );
        hasHistoryEntry = true;
      });

      lightbox.on('close', () => {
        if (hasHistoryEntry && !closingFromHistory) {
          hasHistoryEntry = false;
          history.back();
        }
        closingFromHistory = false;
      });

      lightbox.on('destroy', () => {
        window.removeEventListener('popstate', onPopState);
      });

      window.addEventListener('popstate', onPopState);

      lightbox.on('uiRegister', () => {
        lightbox.pswp?.ui?.registerElement({
          name: 'genealogy-caption',
          order: 9,
          isButton: false,
          appendTo: 'root',
          html: '',
          onInit: (element, pswp) => {
            const update = () => {
              const anchor = pswp.currSlide?.data.element as HTMLElement | undefined;
              element.textContent = anchor?.dataset.pswpCaption ?? '';
              element.hidden = !element.textContent;
            };
            pswp.on('change', update);
            update();
          },
        });
      });

      lightbox.init();
      gallery.dataset.pswpReady = 'true';
    }
  }

  initPhotoSwipe();
  document.addEventListener('astro:page-load', initPhotoSwipe);
</script>

<style>
  .person-gallery-section {
    margin-top: 2.75rem;
  }

  .person-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .person-gallery-item {
    min-width: 0;
    margin: 0;
  }

  .person-gallery-mount {
    position: relative;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.7rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-hairline);
    text-decoration: none;
  }

  .person-gallery-mount-cross {
    position: absolute;
    inset: 8%;
    width: 84%;
    height: 84%;
    fill: currentColor;
    opacity: 0.72;
    pointer-events: none;
  }

  .person-gallery-window {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    overflow: hidden;
    padding: clamp(3px, 0.55vw, 6px);
    background: #000;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.9);
  }

  .person-gallery-window.is-landscape {
    width: 78%;
    aspect-ratio: 4 / 3;
  }

  .person-gallery-window.is-portrait {
    width: 58.5%;
    aspect-ratio: 3 / 4;
  }

  .person-gallery-photo {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    object-fit: contain;
    background: #000;
  }

  .person-gallery-mount:hover,
  .person-gallery-mount:focus-visible {
    border-color: var(--sl-color-accent);
  }

  .person-gallery-mount:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .person-gallery-item figcaption {
    display: flex;
    gap: 0.5rem;
    justify-content: space-between;
    margin-top: 0.4rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    line-height: 1.35;
  }

  .person-gallery-item figcaption span {
    display: block;
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .person-gallery-item time {
    flex: none;
    color: var(--sl-color-gray-4);
    font-variant-numeric: tabular-nums;
  }

  :global(.pswp__genealogy-caption) {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 2.5rem 1rem 1rem;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.72));
    color: white;
    font-size: 0.95rem;
    line-height: 1.4;
    text-align: center;
    pointer-events: none;
  }

  @media (max-width: 36rem) {
    .person-gallery {
      gap: 0.75rem;
    }

    .person-gallery-item figcaption {
      display: block;
    }

    .person-gallery-item figcaption span {
      width: 100%;
    }

    .person-gallery-item time {
      display: block;
      margin-top: 0.15rem;
    }
  }
</style>
