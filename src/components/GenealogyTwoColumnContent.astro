---
/**
 * Starlight TwoColumnContent override.
 * The reading column actually reclaims the width of a collapsed ToC, while
 * the open ToC stays pinned and scrolls independently on wide desktops.
 */
---

<div class="lg:sl-flex genealogy-columns">
  {
    Astro.locals.starlightRoute.toc && (
      <aside class="right-sidebar-container print:hidden">
        <div class="right-sidebar">
          <button
            type="button"
            class="toc-close"
            data-panel-toggle="toc"
            aria-label="Скрыть оглавление"
            title="Скрыть оглавление"
            aria-pressed="true"
          ></button>
          <slot name="right-sidebar" />
        </div>
      </aside>
    )
  }
  <div class="main-pane">
    <slot />
  </div>
</div>

<style>
  @layer starlight.core {
    .main-pane {
      isolation: isolate;
      min-width: 0;
    }

    .toc-close {
      display: none;
    }

    @media (min-width: 72rem) {
      .genealogy-columns {
        --genealogy-toc-column: clamp(14rem, 18vw, 18rem);
        display: flex;
        width: 100%;
        min-width: 0;
        align-items: stretch;
      }

      .genealogy-columns .right-sidebar-container {
        order: 2;
        flex: 0 0 var(--genealogy-toc-column);
        width: var(--genealogy-toc-column);
        min-width: 0;
        align-self: stretch;
        overflow: clip;
      }

      /* Reserve the flex column for layout, but anchor the ToC itself to the
         viewport like RSLive's fixed navigation. A sticky child follows the
         page during Edge elastic overscroll. */
      .genealogy-columns .right-sidebar {
        position: fixed;
        top: var(--sl-nav-height);
        right: 0;
        width: var(--genealogy-toc-column);
        height: calc(100vh - var(--sl-nav-height));
        height: calc(100dvh - var(--sl-nav-height));
        box-sizing: border-box;
        overflow-x: hidden;
        overflow-y: auto;
        scrollbar-width: thin;
        border-inline-start: 1px solid var(--sl-color-hairline);
        padding: 2.7rem 1rem 2rem;
      }

      .genealogy-columns .main-pane {
        order: 1;
        flex: 1 1 0;
        width: auto;
        min-width: 0;
        --sl-content-margin-inline: auto;
      }

      .toc-close {
        /* Placement and visibility belong to ToC layout. All button visuals
           and geometry are shared with Starlight's mobile menu in
           photo-album.css. Do not override its size or styling here. */
        position: absolute;
        top: 0.65rem;
        right: 0.75rem;
        z-index: 2;
        display: grid;
        place-items: center;
        cursor: pointer;
      }

      :global(html.genealogy-hide-toc) .toc-close,
      :global(html.genealogy-auto-hide-toc) .toc-close {
        display: none;
      }
    }
  }
</style>
