---
import 'maplibre-gl/dist/maplibre-gl.css';
---

<section class="event-map-shell" data-event-map>
  <div class="event-map-toolbar" aria-label="Фильтр событий по годам">
    <div class="event-map-toolbar-head">
      <strong>Период</strong>
      <output data-range-label>Загрузка…</output>
    </div>
    <div class="event-map-range" data-range-control hidden>
      <input data-range-from type="range" aria-label="Начальный год" />
      <input data-range-to type="range" aria-label="Конечный год" />
    </div>
    <div class="event-map-stats" data-map-stats aria-live="polite"></div>
  </div>

  <div class="event-map-canvas" data-event-map-canvas aria-label="Карта всех географически привязанных событий"></div>

  <noscript>Для интерактивной карты требуется JavaScript.</noscript>
</section>

<script>
  type MapTheme = 'dark' | 'light';
  type EventProperties = {
    eventRef: string;
    eventUrl: string;
    eventTitle: string;
    kind?: string | null;
    date?: unknown;
    endDate?: unknown;
    startYear?: number | null;
    endYear?: number | null;
    placeRef: string;
    placeLabel: string;
    precision?: string | null;
    participants?: string[];
  };
  type EventFeature = {
    type: 'Feature';
    geometry: { type: 'Point'; coordinates: [number, number] };
    properties: EventProperties;
  };
  type EventCollection = { type: 'FeatureCollection'; features: EventFeature[] };

  const mapStyleUrls: Record<MapTheme, string> = {
    dark: 'https://tiles.openfreemap.org/styles/fiord',
    light: 'https://tiles.openfreemap.org/styles/bright',
  };

  function readMapTheme(): MapTheme {
    const documentTheme = document.documentElement.dataset.theme;
    if (documentTheme === 'light' || documentTheme === 'dark') return documentTheme;
    return window.matchMedia?.('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
  }

  function collapseAttributionControl(root: HTMLElement) {
    const control = root.querySelector('.maplibregl-ctrl-attrib');
    if (!(control instanceof HTMLElement)) return;
    control.classList.add('maplibregl-compact');
    control.classList.remove('maplibregl-compact-show');
    const button = control.querySelector('.maplibregl-ctrl-attrib-button');
    if (button instanceof HTMLElement) button.setAttribute('aria-expanded', 'false');
  }

  function formatDateValue(value: unknown): string {
    if (typeof value === 'number') return String(value);
    if (typeof value === 'string') return value;
    if (!value || typeof value !== 'object') return '';
    const date = value as { year?: number; month?: number; day?: number; text?: string };
    if (date.text) return date.text;
    if (!date.year) return '';
    return [date.day, date.month, date.year].filter(Boolean).join('.');
  }

  function eventDateLabel(feature: EventFeature): string {
    const start = formatDateValue(feature.properties.date);
    const end = formatDateValue(feature.properties.endDate);
    return end && end !== start ? `${start || '…'}–${end}` : start;
  }

  function overlaps(feature: EventFeature, from: number, to: number): boolean {
    const start = feature.properties.startYear;
    const end = feature.properties.endYear ?? start;
    if (!Number.isFinite(start) || !Number.isFinite(end)) return false;
    return Number(start) <= to && Number(end) >= from;
  }

  async function initializeEventMaps() {
    const roots = document.querySelectorAll<HTMLElement>('[data-event-map]:not([data-map-ready])');
    if (!roots.length) return;

    const [maplibreModule, response] = await Promise.all([
      import('maplibre-gl'),
      fetch('/generated/places.geojson'),
    ]);
    if (!response.ok) return;
    const { default: maplibregl } = maplibreModule;
    const dataset = await response.json() as EventCollection;
    const allFeatures = dataset.features ?? [];
    const datedFeatures = allFeatures.filter((feature) => Number.isFinite(feature.properties.startYear));
    const years = datedFeatures.flatMap((feature) => [
      Number(feature.properties.startYear),
      Number(feature.properties.endYear ?? feature.properties.startYear),
    ]).filter(Number.isFinite);
    if (!years.length) return;
    const datasetMin = Math.min(...years);
    const datasetMax = Math.max(...years);

    for (const root of roots) {
      const canvas = root.querySelector<HTMLElement>('[data-event-map-canvas]');
      const fromInput = root.querySelector<HTMLInputElement>('[data-range-from]');
      const toInput = root.querySelector<HTMLInputElement>('[data-range-to]');
      const rangeControl = root.querySelector<HTMLElement>('[data-range-control]');
      const rangeLabel = root.querySelector<HTMLOutputElement>('[data-range-label]');
      const stats = root.querySelector<HTMLElement>('[data-map-stats]');
      if (!canvas || !fromInput || !toInput || !rangeLabel || !stats || !rangeControl) continue;

      const mapCanvas = canvas;
      const fromControl = fromInput;
      const toControl = toInput;
      const output = rangeLabel;
      const status = stats;

      for (const input of [fromControl, toControl]) {
        input.min = String(datasetMin);
        input.max = String(datasetMax);
        input.step = '1';
      }
      fromControl.value = String(datasetMin);
      toControl.value = String(datasetMax);
      rangeControl.hidden = false;

      let currentTheme = readMapTheme();
      let currentFrom = datasetMin;
      let currentTo = datasetMax;
      const sourceId = 'genealogy-events';
      const clusterLayer = 'genealogy-event-clusters';
      const clusterCountLayer = 'genealogy-event-cluster-count';
      const pointLayer = 'genealogy-event-points';

      const filteredCollection = (): EventCollection => ({
        type: 'FeatureCollection',
        features: datedFeatures.filter((feature) => overlaps(feature, currentFrom, currentTo)),
      });

      const map = new maplibregl.Map({
        container: mapCanvas,
        style: mapStyleUrls[currentTheme],
        center: [30, 52],
        zoom: 2.5,
        attributionControl: false,
      });
      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
      map.addControl(new maplibregl.AttributionControl({ compact: true }), 'bottom-right');

      const collapseAttribution = () => collapseAttributionControl(root);

      function addEventLayers() {
        if (map.getSource(sourceId)) return;
        map.addSource(sourceId, {
          type: 'geojson',
          data: filteredCollection(),
          cluster: true,
          clusterMaxZoom: 13,
          clusterRadius: 44,
        });
        map.addLayer({
          id: clusterLayer,
          type: 'circle',
          source: sourceId,
          filter: ['has', 'point_count'],
          paint: {
            'circle-color': '#64748b',
            'circle-radius': ['step', ['get', 'point_count'], 18, 10, 23, 30, 28],
            'circle-stroke-width': 2,
            'circle-stroke-color': '#ffffff',
          },
        });
        map.addLayer({
          id: clusterCountLayer,
          type: 'symbol',
          source: sourceId,
          filter: ['has', 'point_count'],
          layout: {
            'text-field': ['get', 'point_count_abbreviated'],
            'text-size': 12,
          },
          paint: { 'text-color': '#ffffff' },
        });
        map.addLayer({
          id: pointLayer,
          type: 'circle',
          source: sourceId,
          filter: ['!', ['has', 'point_count']],
          paint: {
            'circle-color': '#e05252',
            'circle-radius': 7,
            'circle-stroke-width': 2,
            'circle-stroke-color': '#ffffff',
          },
        });
      }

      function updateRange() {
        let from = Number(fromControl.value);
        let to = Number(toControl.value);
        if (from > to) {
          if (document.activeElement === fromControl) to = from;
          else from = to;
          fromControl.value = String(from);
          toControl.value = String(to);
        }
        currentFrom = from;
        currentTo = to;
        output.value = from === to ? String(from) : `${from}–${to}`;
        const filtered = filteredCollection();
        status.textContent = `${filtered.features.length} из ${datedFeatures.length} геопривязанных событий`;
        const source = map.getSource(sourceId) as import('maplibre-gl').GeoJSONSource | undefined;
        source?.setData(filtered);
      }

      map.on('load', () => {
        addEventLayers();
        updateRange();
        collapseAttribution();
      });
      map.once('idle', collapseAttribution);

      map.on('click', clusterLayer, async (event) => {
        const feature = map.queryRenderedFeatures(event.point, { layers: [clusterLayer] })[0];
        const clusterId = feature?.properties?.cluster_id;
        const source = map.getSource(sourceId) as import('maplibre-gl').GeoJSONSource | undefined;
        if (!source || clusterId === undefined || feature.geometry.type !== 'Point') return;
        const zoom = await source.getClusterExpansionZoom(clusterId);
        map.easeTo({ center: feature.geometry.coordinates as [number, number], zoom });
      });

      map.on('click', pointLayer, (event) => {
        const feature = event.features?.[0] as unknown as EventFeature | undefined;
        if (!feature || feature.geometry.type !== 'Point') return;
        const container = document.createElement('div');
        container.className = 'genealogy-map-popup';
        const date = eventDateLabel(feature);
        if (date) {
          const time = document.createElement('div');
          time.className = 'genealogy-map-popup-date';
          time.textContent = date;
          container.append(time);
        }
        const title = document.createElement('a');
        title.href = feature.properties.eventUrl;
        title.textContent = feature.properties.eventTitle;
        title.className = 'genealogy-map-popup-title';
        container.append(title);
        const place = document.createElement('div');
        place.textContent = feature.properties.placeLabel;
        container.append(place);
        new maplibregl.Popup({ offset: 12 })
          .setLngLat(feature.geometry.coordinates)
          .setDOMContent(container)
          .addTo(map);
      });

      for (const layerId of [clusterLayer, pointLayer]) {
        map.on('mouseenter', layerId, () => { map.getCanvas().style.cursor = 'pointer'; });
        map.on('mouseleave', layerId, () => { map.getCanvas().style.cursor = ''; });
      }

      fromControl.addEventListener('input', updateRange);
      toControl.addEventListener('input', updateRange);

      const preference = window.matchMedia?.('(prefers-color-scheme: light)');
      const syncTheme = () => {
        const nextTheme = readMapTheme();
        if (nextTheme === currentTheme) return;
        currentTheme = nextTheme;
        map.setStyle(mapStyleUrls[currentTheme]);
        map.once('style.load', () => {
          addEventLayers();
          updateRange();
          collapseAttribution();
        });
      };
      const themeObserver = new MutationObserver(syncTheme);
      themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      preference?.addEventListener('change', syncTheme);

      const cleanup = () => {
        themeObserver.disconnect();
        preference?.removeEventListener('change', syncTheme);
        fromControl.removeEventListener('input', updateRange);
        toControl.removeEventListener('input', updateRange);
        map.remove();
      };
      document.addEventListener('astro:before-swap', cleanup, { once: true });
      root.dataset.mapReady = 'true';
    }
  }

  void initializeEventMaps();
  document.addEventListener('astro:page-load', () => void initializeEventMaps());
</script>

<style>
  .event-map-shell {
    --map-control-bg: #ffffff;
    --map-control-hover: #f1f5f9;
    --map-control-fg: #1f2937;
    --map-control-border: #d7dde4;
    --map-popup-bg: #ffffff;
    --map-popup-fg: #1f2937;
    --map-link: #1d4ed8;
    margin-top: 1.5rem;
  }
  :global(html[data-theme='dark']) .event-map-shell {
    --map-control-bg: #1f2937;
    --map-control-hover: #334155;
    --map-control-fg: #e5e7eb;
    --map-control-border: #475569;
    --map-popup-bg: #1f2937;
    --map-popup-fg: #e5e7eb;
    --map-link: #93c5fd;
  }
  .event-map-toolbar {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-bg-nav);
  }
  .event-map-toolbar-head { display: flex; justify-content: space-between; gap: 1rem; }
  .event-map-toolbar output { font-variant-numeric: tabular-nums; font-weight: 700; }
  .event-map-stats { color: var(--sl-color-gray-3); font-size: 0.82rem; }
  .event-map-range { position: relative; height: 1.75rem; }
  .event-map-range input[type='range'] {
    position: absolute;
    inset: 0;
    width: 100%;
    margin: 0;
    background: transparent;
    pointer-events: none;
  }
  .event-map-range input[type='range']::-webkit-slider-thumb { pointer-events: auto; }
  .event-map-range input[type='range']::-moz-range-thumb { pointer-events: auto; }
  .event-map-canvas {
    width: 100%;
    height: min(68vh, 46rem);
    min-height: 30rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .event-map-shell :global(.maplibregl-ctrl-group) {
    overflow: hidden;
    border: 1px solid var(--map-control-border);
    border-radius: 0.55rem;
    background: var(--map-control-bg) !important;
    box-shadow: 0 2px 9px rgb(15 23 42 / 16%);
  }
  .event-map-shell :global(.maplibregl-ctrl-group button) { background-color: var(--map-control-bg) !important; color: var(--map-control-fg) !important; }
  .event-map-shell :global(.maplibregl-ctrl-group button:hover),
  .event-map-shell :global(.maplibregl-ctrl-group button:focus-visible) { background-color: var(--map-control-hover) !important; }
  .event-map-shell :global(.maplibregl-ctrl-group button + button) { border-top-color: var(--map-control-border) !important; }
  :global(html[data-theme='dark']) .event-map-shell :global(.maplibregl-ctrl-group .maplibregl-ctrl-icon),
  :global(html[data-theme='dark']) .event-map-shell :global(.maplibregl-ctrl-attrib-button) { filter: invert(1) brightness(1.35); }
  .event-map-shell :global(.maplibregl-ctrl-attrib) {
    border: 1px solid var(--map-control-border);
    background: color-mix(in srgb, var(--map-control-bg) 92%, transparent) !important;
    color: var(--map-control-fg);
    backdrop-filter: blur(8px);
  }
  .event-map-shell :global(.maplibregl-ctrl-attrib a) { color: var(--map-link); }
  .event-map-shell :global(.maplibregl-popup-content) {
    border: 1px solid var(--map-control-border);
    border-radius: 0.65rem;
    background: var(--map-popup-bg);
    color: var(--map-popup-fg);
    box-shadow: 0 5px 20px rgb(15 23 42 / 24%);
  }
  .event-map-shell :global(.maplibregl-popup-close-button) { color: var(--map-popup-fg); }
  .event-map-shell :global(.maplibregl-popup-anchor-top .maplibregl-popup-tip) { border-bottom-color: var(--map-popup-bg); }
  .event-map-shell :global(.maplibregl-popup-anchor-bottom .maplibregl-popup-tip) { border-top-color: var(--map-popup-bg); }
  .event-map-shell :global(.maplibregl-popup-anchor-left .maplibregl-popup-tip) { border-right-color: var(--map-popup-bg); }
  .event-map-shell :global(.maplibregl-popup-anchor-right .maplibregl-popup-tip) { border-left-color: var(--map-popup-bg); }
  .event-map-shell :global(.genealogy-map-popup) { display: grid; gap: 0.3rem; min-width: 12rem; }
  .event-map-shell :global(.genealogy-map-popup-date) { opacity: 0.72; font-size: 0.78rem; font-weight: 700; }
  .event-map-shell :global(.genealogy-map-popup-title) { color: var(--map-link); font-weight: 700; }

  @media (max-width: 40rem) {
    .event-map-canvas { min-height: 25rem; height: 62vh; }
  }
</style>
