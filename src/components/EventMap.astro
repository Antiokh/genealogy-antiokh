---
import 'maplibre-gl/dist/maplibre-gl.css';
---

<section class="event-map-shell" data-event-map>
  <div class="event-map-canvas" data-event-map-canvas aria-label="Карта всех географически привязанных событий"></div>

  <div class="event-map-period" data-range-control hidden aria-label="Фильтр событий по годам">
    <output data-range-label>Временной интервал: загрузка…</output>
    <div class="event-map-range" data-range-track>
      <input data-range-from type="range" aria-label="Начальный год" />
      <input data-range-to type="range" aria-label="Конечный год" />
    </div>
  </div>

  <noscript>Для интерактивной карты требуется JavaScript.</noscript>
</section>

<script>
  type MapTheme = 'dark' | 'light';
  type EventProperties = {
    eventRef: string;
    eventUrl: string;
    eventTitle: string;
    kind?: string | null;
    date?: unknown;
    endDate?: unknown;
    startYear?: number | null;
    endYear?: number | null;
    placeRef: string;
    placeLabel: string;
    precision?: string | null;
    participants?: string[];
  };
  type EventFeature = {
    type: 'Feature';
    geometry: { type: 'Point'; coordinates: [number, number] };
    properties: EventProperties;
  };
  type EventCollection = { type: 'FeatureCollection'; features: EventFeature[] };

  const mapStyleUrls: Record<MapTheme, string> = {
    dark: 'https://tiles.openfreemap.org/styles/fiord',
    light: 'https://tiles.openfreemap.org/styles/bright',
  };

  function readMapTheme(): MapTheme {
    const documentTheme = document.documentElement.dataset.theme;
    if (documentTheme === 'light' || documentTheme === 'dark') return documentTheme;
    return window.matchMedia?.('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
  }

  function collapseAttributionControl(root: HTMLElement) {
    const control = root.querySelector('.maplibregl-ctrl-attrib');
    if (!(control instanceof HTMLElement)) return;
    control.classList.add('maplibregl-compact');
    control.classList.remove('maplibregl-compact-show');
    const button = control.querySelector('.maplibregl-ctrl-attrib-button');
    if (button instanceof HTMLElement) button.setAttribute('aria-expanded', 'false');
  }

  function formatDateValue(value: unknown): string {
    if (typeof value === 'number') return String(value);
    if (typeof value === 'string') return value;
    if (!value || typeof value !== 'object') return '';
    const date = value as { year?: number; month?: number; day?: number; text?: string };
    if (date.text) return date.text;
    if (!date.year) return '';
    return [date.day, date.month, date.year].filter(Boolean).join('.');
  }

  function eventDateLabel(feature: EventFeature): string {
    const start = formatDateValue(feature.properties.date);
    const end = formatDateValue(feature.properties.endDate);
    return end && end !== start ? `${start || '…'}–${end}` : start;
  }

  function overlaps(feature: EventFeature, from: number, to: number): boolean {
    const start = feature.properties.startYear;
    const end = feature.properties.endYear ?? start;
    if (!Number.isFinite(start) || !Number.isFinite(end)) return false;
    return Number(start) <= to && Number(end) >= from;
  }

  function overviewIcon(): SVGSVGElement {
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('viewBox', '0 0 24 24');
    svg.setAttribute('aria-hidden', 'true');
    svg.classList.add('rslive-map-overview-icon');
    for (const [cx, cy, radius] of [[7, 8, 2.2], [16.5, 7, 1.8], [13, 16, 2.4]]) {
      const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      circle.setAttribute('cx', String(cx));
      circle.setAttribute('cy', String(cy));
      circle.setAttribute('r', String(radius));
      svg.append(circle);
    }
    return svg;
  }

  class HomeControl {
    private container?: HTMLDivElement;
    private button?: HTMLButtonElement;
    private readonly onOverview: () => void;

    constructor(onOverview: () => void) {
      this.onOverview = onOverview;
    }

    onAdd() {
      this.container = document.createElement('div');
      this.container.className = 'maplibregl-ctrl maplibregl-ctrl-group';
      this.button = document.createElement('button');
      this.button.type = 'button';
      this.button.className = 'rslive-map-home';
      this.button.title = 'Показать все события';
      this.button.setAttribute('aria-label', 'Показать все события');
      this.button.append(overviewIcon());
      this.button.addEventListener('click', this.onOverview);
      this.container.append(this.button);
      return this.container;
    }

    onRemove() {
      this.button?.removeEventListener('click', this.onOverview);
      this.container?.remove();
    }
  }

  async function initializeEventMaps() {
    const roots = document.querySelectorAll<HTMLElement>('[data-event-map]:not([data-map-ready])');
    if (!roots.length) return;

    const [maplibreModule, response] = await Promise.all([
      import('maplibre-gl'),
      fetch('/generated/places.geojson'),
    ]);
    if (!response.ok) return;

    const { default: maplibregl } = maplibreModule;
    const dataset = await response.json() as EventCollection;
    const allFeatures = dataset.features ?? [];
    const datedFeatures = allFeatures.filter((feature) => Number.isFinite(feature.properties.startYear));
    const years = datedFeatures.flatMap((feature) => [
      Number(feature.properties.startYear),
      Number(feature.properties.endYear ?? feature.properties.startYear),
    ]).filter(Number.isFinite);
    if (!years.length) return;

    const datasetMin = Math.min(...years);
    const datasetMax = Math.max(...years);

    for (const root of roots) {
      const canvas = root.querySelector<HTMLElement>('[data-event-map-canvas]');
      const fromInput = root.querySelector<HTMLInputElement>('[data-range-from]');
      const toInput = root.querySelector<HTMLInputElement>('[data-range-to]');
      const rangeControl = root.querySelector<HTMLElement>('[data-range-control]');
      const rangeTrack = root.querySelector<HTMLElement>('[data-range-track]');
      const rangeLabel = root.querySelector<HTMLOutputElement>('[data-range-label]');
      if (!canvas || !fromInput || !toInput || !rangeLabel || !rangeControl || !rangeTrack) continue;

      const mapCanvas = canvas;
      const fromControl = fromInput;
      const toControl = toInput;
      const output = rangeLabel;
      const rangeTrackElement = rangeTrack;

      for (const input of [fromControl, toControl]) {
        input.min = String(datasetMin);
        input.max = String(datasetMax);
        input.step = '1';
      }
      fromControl.value = String(datasetMin);
      toControl.value = String(datasetMax);
      rangeControl.hidden = false;

      let currentTheme = readMapTheme();
      let currentFrom = datasetMin;
      let currentTo = datasetMax;
      const sourceId = 'genealogy-events';
      const clusterLayer = 'genealogy-event-clusters';
      const clusterCountLayer = 'genealogy-event-cluster-count';
      const pointLayer = 'genealogy-event-points';

      const filteredCollection = (): EventCollection => ({
        type: 'FeatureCollection',
        features: datedFeatures.filter((feature) => overlaps(feature, currentFrom, currentTo)),
      });

      const map = new maplibregl.Map({
        container: mapCanvas,
        style: mapStyleUrls[currentTheme],
        center: [30, 52],
        zoom: 2.5,
        attributionControl: false,
        renderWorldCopies: false,
      });

      function fitOverview() {
        const features = filteredCollection().features;
        if (!features.length) return;
        if (features.length === 1) {
          map.easeTo({ center: features[0].geometry.coordinates, zoom: Math.max(map.getZoom(), 7) });
          return;
        }
        const bounds = new maplibregl.LngLatBounds();
        for (const feature of features) bounds.extend(feature.geometry.coordinates);
        map.fitBounds(bounds, { padding: 52, maxZoom: 10, duration: 450 });
      }

      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
      map.addControl(new HomeControl(fitOverview), 'top-right');
      map.addControl(new maplibregl.FullscreenControl({ container: root }), 'top-right');
      map.addControl(new maplibregl.GeolocateControl({
        positionOptions: { enableHighAccuracy: true },
        trackUserLocation: true,
      }), 'top-right');
      map.addControl(new maplibregl.ScaleControl({ maxWidth: 90, unit: 'metric' }), 'bottom-left');
      map.addControl(new maplibregl.AttributionControl({ compact: true }), 'bottom-right');

      const collapseAttribution = () => collapseAttributionControl(root);

      function addEventLayers() {
        if (map.getSource(sourceId)) return;
        map.addSource(sourceId, {
          type: 'geojson',
          data: filteredCollection(),
          cluster: true,
          clusterMaxZoom: 13,
          clusterRadius: 44,
        });
        map.addLayer({
          id: clusterLayer,
          type: 'circle',
          source: sourceId,
          filter: ['has', 'point_count'],
          paint: {
            'circle-color': '#64748b',
            'circle-radius': ['step', ['get', 'point_count'], 18, 10, 23, 30, 28],
            'circle-stroke-width': 2,
            'circle-stroke-color': '#ffffff',
          },
        });
        map.addLayer({
          id: clusterCountLayer,
          type: 'symbol',
          source: sourceId,
          filter: ['has', 'point_count'],
          layout: {
            'text-field': ['get', 'point_count_abbreviated'],
            'text-size': 12,
          },
          paint: { 'text-color': '#ffffff' },
        });
        map.addLayer({
          id: pointLayer,
          type: 'circle',
          source: sourceId,
          filter: ['!', ['has', 'point_count']],
          paint: {
            'circle-color': '#e05252',
            'circle-radius': 7,
            'circle-stroke-width': 2,
            'circle-stroke-color': '#ffffff',
          },
        });
      }

      function updateRange() {
        let from = Number(fromControl.value);
        let to = Number(toControl.value);
        if (from > to) {
          if (document.activeElement === fromControl) to = from;
          else from = to;
          fromControl.value = String(from);
          toControl.value = String(to);
        }

        currentFrom = from;
        currentTo = to;
        const value = from === to ? String(from) : `${from}–${to}`;
        output.value = `Временной интервал: ${value}`;

        const span = Math.max(1, datasetMax - datasetMin);
        const fromPercent = ((from - datasetMin) / span) * 100;
        const toPercent = ((to - datasetMin) / span) * 100;
        rangeTrackElement.style.setProperty('--range-from', `${fromPercent}%`);
        rangeTrackElement.style.setProperty('--range-to', `${toPercent}%`);

        const source = map.getSource(sourceId) as import('maplibre-gl').GeoJSONSource | undefined;
        source?.setData(filteredCollection());
      }

      map.on('load', () => {
        addEventLayers();
        updateRange();
        collapseAttribution();
        fitOverview();
      });
      map.once('idle', collapseAttribution);

      map.on('click', clusterLayer, async (event) => {
        const feature = map.queryRenderedFeatures(event.point, { layers: [clusterLayer] })[0];
        const clusterId = feature?.properties?.cluster_id;
        const source = map.getSource(sourceId) as import('maplibre-gl').GeoJSONSource | undefined;
        if (!source || clusterId === undefined || feature.geometry.type !== 'Point') return;
        const zoom = await source.getClusterExpansionZoom(clusterId);
        map.easeTo({ center: feature.geometry.coordinates as [number, number], zoom });
      });

      map.on('click', pointLayer, (event) => {
        const feature = event.features?.[0] as unknown as EventFeature | undefined;
        if (!feature || feature.geometry.type !== 'Point') return;

        const container = document.createElement('div');
        container.className = 'genealogy-map-popup rslive-map-popup';

        const title = document.createElement('strong');
        title.textContent = feature.properties.eventTitle;
        container.append(title);

        const details = document.createElement('p');
        const date = eventDateLabel(feature);
        details.textContent = [date, feature.properties.placeLabel].filter(Boolean).join('\n');
        container.append(details);

        const link = document.createElement('a');
        link.href = feature.properties.eventUrl;
        link.textContent = 'Открыть событие';
        container.append(link);

        new maplibregl.Popup({ maxWidth: 'min(22rem, 80vw)', offset: 12 })
          .setLngLat(feature.geometry.coordinates)
          .setDOMContent(container)
          .addTo(map);
      });

      for (const layerId of [clusterLayer, pointLayer]) {
        map.on('mouseenter', layerId, () => { map.getCanvas().style.cursor = 'pointer'; });
        map.on('mouseleave', layerId, () => { map.getCanvas().style.cursor = ''; });
      }

      fromControl.addEventListener('input', updateRange);
      toControl.addEventListener('input', updateRange);

      const preference = window.matchMedia?.('(prefers-color-scheme: light)');
      const syncTheme = () => {
        const nextTheme = readMapTheme();
        if (nextTheme === currentTheme) return;
        currentTheme = nextTheme;
        map.setStyle(mapStyleUrls[currentTheme]);
        map.once('style.load', () => {
          addEventLayers();
          updateRange();
          collapseAttribution();
        });
      };
      const themeObserver = new MutationObserver(syncTheme);
      themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      preference?.addEventListener('change', syncTheme);

      const cleanup = () => {
        themeObserver.disconnect();
        preference?.removeEventListener('change', syncTheme);
        fromControl.removeEventListener('input', updateRange);
        toControl.removeEventListener('input', updateRange);
        map.remove();
      };
      document.addEventListener('astro:before-swap', cleanup, { once: true });
      root.dataset.mapReady = 'true';
    }
  }

  void initializeEventMaps();
  document.addEventListener('astro:page-load', () => void initializeEventMaps());
</script>

<style>
  .event-map-shell {
    --map-popup-bg: #ffffff;
    --map-popup-fg: #1f2937;
    --map-panel-bg: rgb(255 255 255 / 92%);
    --map-panel-fg: #1f2937;
    --map-panel-muted: #64748b;
    --map-panel-border: rgb(148 163 184 / 42%);
    --map-control-bg: #ffffff;
    --map-control-hover: #f1f5f9;
    --map-control-fg: #1f2937;
    --map-control-border: #d7dde4;
    --map-link: #1d4ed8;
    --map-range-track: #cbd5e1;
    --map-range-active: #2563eb;
    position: relative;
    margin-top: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    color-scheme: light;
  }

  :global(html[data-theme='dark']) .event-map-shell {
    --map-popup-bg: #1f2937;
    --map-popup-fg: #e5e7eb;
    --map-panel-bg: rgb(23 33 41 / 92%);
    --map-panel-fg: #e5e7eb;
    --map-panel-muted: #aab4bd;
    --map-panel-border: rgb(100 116 139 / 50%);
    --map-control-bg: #1f2937;
    --map-control-hover: #334155;
    --map-control-fg: #e5e7eb;
    --map-control-border: #475569;
    --map-link: #93c5fd;
    --map-range-track: #475569;
    --map-range-active: #60a5fa;
    color-scheme: dark;
  }

  .event-map-canvas {
    width: 100%;
    height: min(68vh, 46rem);
    min-height: 30rem;
  }

  .event-map-period {
    position: absolute;
    z-index: 8;
    top: calc(max(0.45rem, env(safe-area-inset-top)) + 10px);
    left: 0;
    width: min(72vw, 30rem);
    padding: 0.55rem 0.8rem 0.6rem max(0.8rem, calc(env(safe-area-inset-left) + 0.4rem));
    border: 1px solid var(--map-panel-border);
    border-left: 0;
    border-radius: 0 0.7rem 0.7rem 0;
    background: var(--map-panel-bg);
    box-shadow: 0 4px 18px rgb(15 23 42 / 14%);
    color: var(--map-panel-fg);
    backdrop-filter: blur(8px);
  }

  .event-map-period[hidden] { display: none; }

  .event-map-period output {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.8rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }

  .event-map-range {
    --range-from: 0%;
    --range-to: 100%;
    position: relative;
    height: 1.25rem;
  }

  .event-map-range::before {
    content: '';
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: 4px;
    transform: translateY(-50%);
    border-radius: 999px;
    background: linear-gradient(
      to right,
      var(--map-range-track) 0 var(--range-from),
      var(--map-range-active) var(--range-from) var(--range-to),
      var(--map-range-track) var(--range-to) 100%
    );
  }

  .event-map-range input[type='range'] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 1.25rem;
    margin: 0;
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    pointer-events: none;
  }

  .event-map-range input[type='range']::-webkit-slider-runnable-track {
    height: 4px;
    border: 0;
    background: transparent;
  }

  .event-map-range input[type='range']::-moz-range-track {
    height: 4px;
    border: 0;
    background: transparent;
  }

  .event-map-range input[type='range']::-moz-range-progress { background: transparent; }

  .event-map-range input[type='range']::-webkit-slider-thumb {
    width: 18px;
    height: 18px;
    margin-top: -7px;
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    border-radius: 999px;
    background: var(--map-range-active);
    box-shadow: 0 1px 3px rgb(15 23 42 / 32%);
    pointer-events: auto;
  }

  .event-map-range input[type='range']::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border: 0;
    border-radius: 999px;
    background: var(--map-range-active);
    box-shadow: 0 1px 3px rgb(15 23 42 / 32%);
    pointer-events: auto;
  }

  .event-map-shell :global(.maplibregl-ctrl-top-left),
  .event-map-shell :global(.maplibregl-ctrl-top-right),
  .event-map-shell :global(.maplibregl-ctrl-bottom-left),
  .event-map-shell :global(.maplibregl-ctrl-bottom-right) {
    z-index: 6;
  }

  .event-map-shell :global(.maplibregl-ctrl-top-right) {
    top: max(0.45rem, env(safe-area-inset-top));
    right: max(0.4rem, env(safe-area-inset-right));
  }

  .event-map-shell :global(.maplibregl-ctrl-group) {
    overflow: hidden;
    border: 1px solid var(--map-control-border);
    border-radius: 0.55rem;
    background: var(--map-control-bg) !important;
    box-shadow: 0 2px 9px rgb(15 23 42 / 16%);
  }

  .event-map-shell :global(.maplibregl-ctrl-group button) {
    display: block;
    width: 29px !important;
    height: 29px !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    background-color: var(--map-control-bg) !important;
    color: var(--map-control-fg) !important;
    line-height: 0;
  }

  .event-map-shell :global(.maplibregl-ctrl-group button:hover),
  .event-map-shell :global(.maplibregl-ctrl-group button:focus-visible) {
    background-color: var(--map-control-hover) !important;
  }

  .event-map-shell :global(.maplibregl-ctrl-group button + button) {
    border-top: 1px solid var(--map-control-border) !important;
  }

  .event-map-shell :global(.rslive-map-home) {
    display: grid !important;
    place-items: center;
  }

  .event-map-shell :global(.rslive-map-overview-icon) {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  :global(html[data-theme='dark']) .event-map-shell :global(.maplibregl-ctrl-group .maplibregl-ctrl-icon),
  :global(html[data-theme='dark']) .event-map-shell :global(.maplibregl-ctrl-attrib-button) {
    filter: invert(1) brightness(1.35);
  }

  /* Same quiet bottom utility layout used by the RSLive map renderer. */
  .event-map-shell :global(.maplibregl-ctrl-bottom-right) {
    left: 0;
    right: auto;
  }

  .event-map-shell :global(.maplibregl-ctrl-bottom-right .maplibregl-ctrl-attrib) {
    margin: 0 0 max(0.55rem, env(safe-area-inset-bottom)) max(0.55rem, env(safe-area-inset-left));
  }

  .event-map-shell :global(.maplibregl-ctrl-attrib) {
    border: 1px solid var(--map-control-border);
    background: color-mix(in srgb, var(--map-control-bg) 92%, transparent) !important;
    color: var(--map-control-fg);
    backdrop-filter: blur(8px);
  }

  .event-map-shell :global(.maplibregl-ctrl-attrib a) { color: var(--map-link); }

  .event-map-shell :global(.maplibregl-ctrl-bottom-left .maplibregl-ctrl-scale) {
    max-width: 4.6rem !important;
    margin: 0 0 max(0.55rem, env(safe-area-inset-bottom)) max(3.15rem, calc(env(safe-area-inset-left) + 3.15rem)) !important;
    padding: 0 0.28rem !important;
    border-color: var(--map-control-fg) !important;
    border-width: 1px !important;
    border-top-width: 0 !important;
    background: color-mix(in srgb, var(--map-control-bg) 58%, transparent) !important;
    color: var(--map-control-fg) !important;
    font-size: 0.64rem !important;
    line-height: 1.2 !important;
    opacity: 0.82;
  }

  .event-map-shell :global(.maplibregl-ctrl-attrib.maplibregl-compact:not(.maplibregl-compact-show) .maplibregl-ctrl-attrib-inner) {
    display: none !important;
  }

  .event-map-shell :global(.maplibregl-popup) {
    z-index: 7;
    max-width: min(22rem, 80vw) !important;
  }

  .event-map-shell :global(.maplibregl-popup-content) {
    max-width: 100%;
    overflow-wrap: anywhere;
    border: 1px solid var(--map-panel-border);
    border-radius: 0.65rem;
    background: var(--map-popup-bg);
    color: var(--map-popup-fg);
    box-shadow: 0 5px 20px rgb(15 23 42 / 24%);
  }

  .event-map-shell :global(.maplibregl-popup-anchor-top .maplibregl-popup-tip),
  .event-map-shell :global(.maplibregl-popup-anchor-top-left .maplibregl-popup-tip),
  .event-map-shell :global(.maplibregl-popup-anchor-top-right .maplibregl-popup-tip) {
    border-bottom-color: var(--map-popup-bg);
  }

  .event-map-shell :global(.maplibregl-popup-anchor-bottom .maplibregl-popup-tip),
  .event-map-shell :global(.maplibregl-popup-anchor-bottom-left .maplibregl-popup-tip),
  .event-map-shell :global(.maplibregl-popup-anchor-bottom-right .maplibregl-popup-tip) {
    border-top-color: var(--map-popup-bg);
  }

  .event-map-shell :global(.maplibregl-popup-anchor-left .maplibregl-popup-tip) { border-right-color: var(--map-popup-bg); }
  .event-map-shell :global(.maplibregl-popup-anchor-right .maplibregl-popup-tip) { border-left-color: var(--map-popup-bg); }

  .event-map-shell :global(.maplibregl-popup-close-button) {
    padding: 0.25rem 0.5rem;
    color: var(--map-popup-fg);
    font-size: 1.15rem;
  }

  .event-map-shell :global(.rslive-map-popup) {
    display: grid;
    gap: 0.42rem;
    min-width: min(15rem, 70vw);
  }

  .event-map-shell :global(.rslive-map-popup strong) {
    padding-right: 1rem;
    font-size: 0.92rem;
    line-height: 1.2;
  }

  .event-map-shell :global(.rslive-map-popup p) {
    margin: 0;
