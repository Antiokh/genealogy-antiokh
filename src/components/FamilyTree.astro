---
type Renderer = 'balkan-classic' | 'family-chart';

interface Props {
  personRef: string;
  renderer?: Renderer;
  priority?: Renderer[];
  showRendererSelector?: boolean;
  heading?: string;
}

const rendererMeta: Record<Renderer, { label: string; src: string }> = {
  'balkan-classic': { label: 'BALKAN classic', src: '/trees/renderers/balkan-familytree-classic/' },
  'family-chart': { label: 'Family Chart', src: '/trees/renderers/family-chart/' },
};

const {
  personRef,
  renderer,
  priority = ['balkan-classic', 'family-chart'],
  showRendererSelector = true,
  heading = 'Семейное дерево',
} = Astro.props;

const selectedRenderer = renderer && rendererMeta[renderer]
  ? renderer
  : priority.find((item) => rendererMeta[item]) || 'balkan-classic';
const canSelectRenderer = showRendererSelector && !renderer;
const instanceId = `family-tree-${personRef.replace(/[^a-z0-9_-]+/gi, '-')}`;
const initialSrc = `${rendererMeta[selectedRenderer].src}?person=${encodeURIComponent(personRef)}`;
---

<section id={instanceId} class="family-tree" data-person={personRef}>
  <div class="family-tree__header">
    <h2>{heading}</h2>
    {canSelectRenderer && (
      <label class="family-tree__renderer">
        <span>Рендерер</span>
        <select data-tree-renderer>
          {(Object.entries(rendererMeta) as [Renderer, { label: string; src: string }][]).map(([key, meta]) => (
            <option value={key} data-src={meta.src} selected={key === selectedRenderer}>{meta.label}</option>
          ))}
        </select>
      </label>
    )}
  </div>

  <div class="family-tree__frame" data-tree-fullscreen-target>
    <iframe
      data-tree-frame
      src={initialSrc}
      title={`${heading}: ${rendererMeta[selectedRenderer].label}`}
      loading="lazy"
    ></iframe>

    <div class="family-tree__map-controls" aria-label="Навигация по семейному дереву">
      <div class="family-tree__control-group">
        <button type="button" data-tree-command="zoom-in" title="Увеличить" aria-label="Увеличить">+</button>
        <button type="button" data-tree-command="zoom-out" title="Уменьшить" aria-label="Уменьшить">−</button>
      </div>
      <div class="family-tree__control-group">
        <button type="button" data-tree-command="focus" title="Вернуться к текущему человеку" aria-label="Вернуться к текущему человеку">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="9" r="3.1"/><path d="M6.8 19c.5-3.4 2.2-5.2 5.2-5.2s4.7 1.8 5.2 5.2"/><path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4"/></svg>
        </button>
      </div>
      <div class="family-tree__control-group">
        <button type="button" data-tree-command="fit" title="Показать всё раскрытое дерево" aria-label="Показать всё раскрытое дерево">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="7" cy="8" r="2.1"/><circle cx="16.5" cy="7" r="1.8"/><circle cx="13" cy="16" r="2.3"/></svg>
        </button>
      </div>
      <div class="family-tree__control-group">
        <button type="button" data-tree-fullscreen title="На весь экран" aria-label="Открыть семейное дерево на весь экран">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ instanceId, personRef }}>
  (() => {
    const root = document.getElementById(instanceId);
    if (!root || root.dataset.ready === '1') return;
    root.dataset.ready = '1';

    const frame = root.querySelector('[data-tree-frame]');
    const renderer = root.querySelector('[data-tree-renderer]');
    const fullscreenTarget = root.querySelector('[data-tree-fullscreen-target]');
    const fullscreen = root.querySelector('[data-tree-fullscreen]');
    const commandButtons = root.querySelectorAll('[data-tree-command]');

    const applyFrameTheme = () => {
      if (!frame) return;
      const parentRoot = document.documentElement;
      const styles = getComputedStyle(parentRoot);
      const background = styles.getPropertyValue('--sl-color-bg').trim();
      const theme = parentRoot.dataset.theme;

      try {
        const doc = frame.contentDocument;
        if (!doc) return;
        if (theme === 'light' || theme === 'dark') {
          doc.documentElement.dataset.theme = theme;
          doc.documentElement.style.colorScheme = theme;
        }
        if (background) {
          doc.documentElement.style.setProperty('--sl-color-bg', background);
          doc.documentElement.style.background = background;
          if (doc.body) {
            doc.body.style.setProperty('--sl-color-bg', background);
            doc.body.style.background = background;
          }
        }
      } catch {}
    };

    const revealFrame = () => {
      applyFrameTheme();
      requestAnimationFrame(() => frame?.classList.add('is-ready'));
    };

    const rendererSrc = () => renderer?.selectedOptions?.[0]?.dataset.src || frame?.src?.split('?')[0] || '';
    const reloadRenderer = () => {
      if (!frame) return;
      frame.classList.remove('is-ready');
      frame.src = `${rendererSrc()}?person=${encodeURIComponent(personRef)}`;
    };

    frame?.addEventListener('load', revealFrame);
    if (frame?.contentDocument?.readyState === 'complete') revealFrame();
    renderer?.addEventListener('change', reloadRenderer);

    const themeObserver = new MutationObserver(applyFrameTheme);
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme', 'class', 'style'],
    });

    const postCommand = (command) => {
      frame?.contentWindow?.postMessage({ type:'genealogy:tree-command', command }, window.location.origin);
    };
    commandButtons.forEach((button) => {
      button.addEventListener('click', () => postCommand(button.dataset.treeCommand));
    });

    const leaveFallbackFullscreen = () => fullscreenTarget?.classList.remove('is-fullscreen');
    fullscreen?.addEventListener('click', async () => {
      if (!fullscreenTarget) return;
      if (document.fullscreenElement === fullscreenTarget) {
        await document.exitFullscreen?.();
        return;
      }
      if (fullscreenTarget.requestFullscreen) {
        try { await fullscreenTarget.requestFullscreen(); return; } catch {}
      }
      fullscreenTarget.classList.toggle('is-fullscreen');
    });
    document.addEventListener('fullscreenchange', () => {
      if (document.fullscreenElement !== fullscreenTarget) leaveFallbackFullscreen();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') leaveFallbackFullscreen();
    });
  })();
</script>

<style>
  .family-tree {
    --tree-control-bg: var(--sl-color-bg-nav, var(--sl-color-bg));
    --tree-control-hover: var(--sl-color-gray-6, var(--sl-color-bg-inline-code));
    --tree-control-fg: var(--sl-color-text);
    --tree-control-border: var(--sl-color-gray-5);
    margin-top: 1.5rem;
  }
  .family-tree__header { display:flex; align-items:flex-end; justify-content:space-between; gap:1rem; margin-bottom:.65rem; }
  .family-tree__header h2 { margin:0; font-size:var(--sl-text-h3); }
  .family-tree__renderer { display:flex; align-items:center; gap:.45rem; }
  .family-tree__renderer span { font-size:.75rem; color:var(--sl-color-gray-2); }
  .family-tree__renderer select {
    min-height:2rem;
    border:1px solid var(--tree-control-border);
    border-radius:.5rem;
    background:var(--tree-control-bg);
    color:var(--tree-control-fg);
    font:inherit;
    font-size:.8rem;
    padding:.35rem .6rem;
    cursor:pointer;
  }

  .family-tree__frame {
    position:relative;
    overflow:hidden;
    border:1px solid var(--sl-color-gray-5);
    border-radius:.75rem;
    background:var(--sl-color-bg);
  }
  .family-tree__frame iframe {
    display:block;
    width:100%;
    height:min(58vh, 36rem);
    min-height:25rem;
    border:0;
    opacity:0;
    background:var(--sl-color-bg);
    transition:opacity .08s linear;
  }
  .family-tree__frame iframe.is-ready { opacity:1; }

  .family-tree__map-controls {
    position:absolute;
    z-index:8;
    top:max(.45rem, env(safe-area-inset-top));
    right:max(.4rem, env(safe-area-inset-right));
    display:grid;
    gap:.45rem;
    pointer-events:none;
  }
  .family-tree__control-group {
    overflow:hidden;
    border:1px solid var(--tree-control-border);
    border-radius:.55rem;
    background:var(--tree-control-bg);
    box-shadow:0 2px 9px rgb(15 23 42 / 16%);
    pointer-events:auto;
  }
  .family-tree__control-group button {
    display:grid;
    place-items:center;
    width:29px;
    height:29px;
    margin:0;
    padding:0;
    border:0;
    background:var(--tree-control-bg);
    color:var(--tree-control-fg);
    font:700 20px/1 system-ui, sans-serif;
    cursor:pointer;
  }
  .family-tree__control-group button + button { border-top:1px solid var(--tree-control-border); }
  .family-tree__control-group button:hover,
  .family-tree__control-group button:focus-visible { background:var(--tree-control-hover); }
  .family-tree__control-group svg {
    width:19px;
    height:19px;
    fill:none;
    stroke:currentColor;
    stroke-width:1.8;
    stroke-linecap:round;
    stroke-linejoin:round;
  }
  .family-tree__control-group svg circle { fill:currentColor; stroke:none; }
  .family-tree__control-group [data-tree-command='focus'] circle { fill:none; stroke:currentColor; }

  .family-tree__frame:fullscreen,
  .family-tree__frame.is-fullscreen {
    width:100vw;
    height:100dvh;
    border:0;
    border-radius:0;
    background:var(--sl-color-bg);
  }
  .family-tree__frame:fullscreen iframe,
  .family-tree__frame.is-fullscreen iframe { height:100%; min-height:0; }
  .family-tree__frame.is-fullscreen { position:fixed; inset:0; z-index:10000; }

  @media (max-width:40rem) {
    .family-tree__header { align-items:stretch; flex-direction:column; }
    .family-tree__renderer { justify-content:space-between; }
    .family-tree__renderer select { flex:1; max-width:15rem; }
    .family-tree__frame iframe { height:55vh; min-height:22rem; }
  }
</style>
