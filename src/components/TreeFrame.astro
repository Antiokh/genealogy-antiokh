---
interface Props {
  src: string;
  title: string;
}
const { src, title } = Astro.props;
---

<section class="tree-embed">
  <iframe src={src} title={title} loading="lazy"></iframe>
</section>

<style>
  .tree-embed {
    margin-top: 1.25rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-bg-nav);
  }
  .tree-embed iframe {
    display: block;
    width: 100%;
    height: min(74vh, 52rem);
    min-height: 34rem;
    border: 0;
  }
  @media (max-width: 40rem) {
    .tree-embed { margin-inline: calc(var(--sl-content-pad-x, 1rem) * -0.35); }
    .tree-embed iframe { min-height: 29rem; height: 70vh; }
  }
</style>
