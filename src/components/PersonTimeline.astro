---
import { getCollection } from 'astro:content';
import { Steps } from '@astrojs/starlight/components';

interface Props {
  personRef: string;
}

const { personRef } = Astro.props;
const docs = await getCollection('docs');

const placeByRef = new Map(
  docs
    .filter((entry) => entry.data.entity === 'place' && entry.id.startsWith('places/'))
    .map((entry) => [
      `${entry.id.replace(/^places\//, '')}.md`,
      entry,
    ]),
);

function dateKey(value: unknown): number {
  if (typeof value === 'number') return value * 10000;
  if (typeof value === 'string') {
    const match = value.match(/^(\d{4})(?:-(\d{2}))?(?:-(\d{2}))?/);
    if (match) return Number(match[1]) * 10000 + Number(match[2] ?? 0) * 100 + Number(match[3] ?? 0);
    return Number.MAX_SAFE_INTEGER;
  }
  if (value && typeof value === 'object' && 'year' in value) {
    const item = value as { year?: number; month?: number; day?: number };
    if (item.year) return item.year * 10000 + (item.month ?? 0) * 100 + (item.day ?? 0);
  }
  return Number.MAX_SAFE_INTEGER;
}

const months = [
  'января', 'февраля', 'марта', 'апреля', 'мая', 'июня',
  'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря',
];

function formatDate(value: unknown): string {
  if (typeof value === 'number') return String(value);
  if (typeof value === 'string') {
    const exact = value.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (exact) return `${Number(exact[3])} ${months[Number(exact[2]) - 1]} ${exact[1]}`;
    const month = value.match(/^(\d{4})-(\d{2})$/);
    if (month) return `${months[Number(month[2]) - 1]} ${month[1]}`;
    return value;
  }
  if (value && typeof value === 'object') {
    const item = value as { year?: number; month?: number; day?: number; circa?: boolean; before?: boolean; after?: boolean; text?: string };
    if (item.text) return item.text;
    if (!item.year) return 'Дата не указана';
    let result = item.day && item.month
      ? `${item.day} ${months[item.month - 1]} ${item.year}`
      : item.month
        ? `${months[item.month - 1]} ${item.year}`
        : String(item.year);
    if (item.circa) result = `ок. ${result}`;
    if (item.before) result = `до ${result}`;
    if (item.after) result = `после ${result}`;
    return result;
  }
  return 'Дата не указана';
}

function eventDateLabel(event: (typeof events)[number]): string {
  const start = formatDate(event.data.date);
  return event.data.endDate ? `${start} — ${formatDate(event.data.endDate)}` : start;
}

const kindLabels: Record<string, string> = {
  birth: 'рождение',
  education: 'образование',
  teaching: 'преподавание',
  career: 'работа',
  research: 'исследования',
  organization: 'организация',
  expedition: 'экспедиция',
  political: 'общественно-политическое',
  arrest: 'арест',
  move: 'переезд',
  illness: 'здоровье',
  death: 'смерть',
  burial: 'захоронение',
};

const events = docs
  .filter((entry) => (
    entry.data.entity === 'event'
    && entry.data.timeline !== false
    && entry.data.participants?.includes(personRef)
  ))
  .sort((a, b) => dateKey(a.data.date) - dateKey(b.data.date) || a.data.title.localeCompare(b.data.title, 'ru'));
---

{events.length > 0 && (
  <section class="person-timeline" aria-labelledby="person-timeline-heading">
    <h2 id="person-timeline-heading">Хронология</h2>
    <Steps>
      <ol>
        {events.map((event) => {
          const eventPlaces = (event.data.places ?? [])
            .map((ref) => ({ ref, entry: placeByRef.get(ref) }))
            .filter((item) => item.entry);
          return (
            <li>
              <p class="timeline-title">
                <span class="timeline-date">{eventDateLabel(event)}</span>
                {' — '}
                <a href={`/${event.id}/`}>{event.data.title}</a>
              </p>
              {event.data.kind && <p class="timeline-kind">{kindLabels[event.data.kind] ?? event.data.kind}</p>}
              {(event.data.summary ?? event.data.description) && (
                <p>{event.data.summary ?? event.data.description}</p>
              )}
              {eventPlaces.length > 0 && (
                <p class="timeline-places">
                  Место:{' '}
                  {eventPlaces.map((item, index) => (
                    <>
                      {index > 0 && ', '}
                      <a href={`/places/${item.ref.replace(/\.mdx?$/, '')}/`}>
                        {item.entry?.data.label ?? item.entry?.data.title ?? item.ref}
                      </a>
                    </>
                  ))}
                </p>
              )}
            </li>
          );
        })}
      </ol>
    </Steps>
  </section>
)}

<style>
  .person-timeline { margin-top: 2.5rem; }
  .person-timeline :global(.sl-steps) { margin-top: 1rem; }
  .timeline-title { margin-bottom: 0.25rem; }
  .timeline-date { font-variant-numeric: tabular-nums; font-weight: 600; }
  .timeline-kind,
  .timeline-places { color: var(--sl-color-gray-3); font-size: 0.875rem; margin-top: 0.2rem; }
  .timeline-kind { text-transform: lowercase; }
</style>
