---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';

const route = Astro.locals.starlightRoute;
const isPerson = route.entry.data.entity === 'person' && route.id.startsWith('people/');
const personRef = isPerson ? `${route.id.replace(/^people\//, '').replace(/\/$/, '')}.md` : null;
const portraitPlaceholderSrc = '/tree/person-placeholder.svg';

const portraitAssets = import.meta.glob('/src/content/docs/people/**/*.webp', {
  eager: true,
  import: 'default',
}) as Record<string, ImageMetadata>;
const conventionalPortrait = isPerson
  ? portraitAssets[`/src/content/docs/${route.id.replace(/\/$/, '')}.webp`]
  : undefined;

const explicitPortrait = route.entry.data.portrait;
const explicitPortraitIsLegacyMedia = typeof explicitPortrait === 'string' && /\.mdx?$/i.test(explicitPortrait);
let portraitEntry;
if (isPerson && explicitPortraitIsLegacyMedia) {
  const portraitStem = explicitPortrait.replace(/\.mdx?$/i, '');
  const docs = await getCollection('docs');
  portraitEntry = docs.find((entry) => entry.data.entity === 'media' && entry.id === `media/${portraitStem}`);
}

function isImageMetadata(value: unknown): value is ImageMetadata {
  return Boolean(
    value
    && typeof value === 'object'
    && 'src' in value
    && 'width' in value
    && 'height' in value,
  );
}

function dateYear(value: unknown): number | undefined {
  if (typeof value === 'number' && Number.isFinite(value)) return Math.trunc(value);
  if (typeof value === 'string') {
    const match = value.match(/(?:^|\D)(\d{4})(?:\D|$)/);
    return match ? Number(match[1]) : undefined;
  }
  if (!value || typeof value !== 'object') return undefined;
  const record = value as Record<string, unknown>;
  if (typeof record.year === 'number' && Number.isFinite(record.year)) return Number(record.year);
  if (record.date !== undefined) return dateYear(record.date);
  if (record.text !== undefined) return dateYear(record.text);
  return undefined;
}

const explicitDirectPortrait = explicitPortraitIsLegacyMedia ? undefined : explicitPortrait;
const usingLegacyMediaPortrait = !conventionalPortrait && !explicitDirectPortrait && Boolean(portraitEntry?.data.image);
const portraitImage = (
  conventionalPortrait
  || explicitDirectPortrait
  || portraitEntry?.data.image
  || route.entry.data.photo
) as string | ImageMetadata | undefined;
const localPortrait = isImageMetadata(portraitImage) ? portraitImage : undefined;
const portraitSrc = typeof portraitImage === 'string' ? portraitImage : localPortrait?.src;
const portraitWidth = localPortrait?.width ?? (usingLegacyMediaPortrait ? portraitEntry?.data.width : undefined);
const portraitHeight = localPortrait?.height ?? (usingLegacyMediaPortrait ? portraitEntry?.data.height : undefined);
const died = route.entry.data.died;
const personDeceased = isPerson && (died?.known === true || Boolean(dateYear(died)));

const personName = route.entry.data.name;
const personLabel = typeof personName === 'string'
  ? personName
  : personName && typeof personName === 'object'
    ? personName.display || personName.full
    : route.entry.data.title;
const portraitAlt = (usingLegacyMediaPortrait ? portraitEntry?.data.alt : undefined) || personLabel || route.entry.data.title || '';

const subject = usingLegacyMediaPortrait
  ? portraitEntry?.data.subjects?.find((value) => {
      if (!personRef) return false;
      return typeof value === 'string' ? value === personRef : value.person === personRef;
    })
  : undefined;
const focal = typeof subject === 'object' ? subject?.focal : undefined;
const objectPosition = focal ? `${focal.x * 100}% ${focal.y * 100}%` : '50% 35%';
---

{isPerson ? (
  <div class="person-title-row">
    <div class="person-title-copy"><Default /></div>
    <figure class="person-portrait">
      <div class={`person-portrait__frame${personDeceased ? ' is-deceased' : ''}`}>
        {localPortrait ? (
          <Image
            class="person-portrait__image"
            src={localPortrait}
            alt={portraitAlt}
            widths={[144, 216, 320]}
            sizes="(max-width: 36rem) 104px, 168px"
            loading="eager"
            decoding="async"
            style={`object-position:${objectPosition}`}
          />
        ) : (
          <img
            class={portraitSrc ? 'person-portrait__image' : 'person-portrait__image is-placeholder'}
            src={portraitSrc || portraitPlaceholderSrc}
            alt={portraitSrc ? portraitAlt : ''}
            width={portraitWidth}
            height={portraitHeight}
            loading="eager"
            decoding="async"
            style={`object-position:${objectPosition}`}
            onerror="this.onerror=null;this.src='/tree/person-placeholder.svg';this.alt='';this.classList.add('is-placeholder');this.closest('figure')?.querySelector('figcaption')?.setAttribute('hidden','')"
          />
        )}
        {personDeceased && <span class="person-portrait__mourning-ribbon" aria-hidden="true"></span>}
      </div>
      {usingLegacyMediaPortrait && portraitEntry?.data.caption && <figcaption>{portraitEntry.data.caption}</figcaption>}
    </figure>
  </div>
) : (
  <Default />
)}

<style>
  .person-title-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(7rem, 18vw, 10.5rem);
    gap: 1.5rem;
    align-items: start;
  }

  .person-title-copy {
    min-width: 0;
  }

  .person-title-copy :global(h1) {
    overflow-wrap: break-word;
    word-break: normal;
    hyphens: auto;
    text-wrap: balance;
  }

  .person-portrait {
    margin: 0.35rem 0 0;
  }

  .person-portrait__frame {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 0.75rem;
  }

  .person-portrait :global(.person-portrait__image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-6);
    box-shadow: 0 0.2rem 0.8rem color-mix(in srgb, var(--sl-color-black) 12%, transparent);
  }

  .person-portrait__frame.is-deceased :global(.person-portrait__image) {
    filter: grayscale(1);
  }

  .person-portrait__mourning-ribbon {
    position: absolute;
    z-index: 3;
    right: -10%;
    bottom: 12%;
    width: 48%;
    height: 0.55rem;
    background: rgba(10, 10, 10, 0.96);
    transform: rotate(-42deg);
    pointer-events: none;
  }

  .person-portrait :global(.person-portrait__image.is-placeholder) {
    object-fit: contain;
    object-position: 50% 50% !important;
    padding: clamp(1rem, 3vw, 1.8rem);
    background: color-mix(in srgb, var(--sl-color-gray-6) 88%, var(--sl-color-bg));
    box-shadow: none;
  }

  .person-portrait figcaption {
    margin-top: 0.35rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    line-height: 1.35;
    text-align: center;
  }

  :global(body:has(.person-title-row) .sl-markdown-content > p:first-child:not(:has(br))) {
    white-space: pre-line;
    line-height: 1.55;
  }

  @media (max-width: 36rem) {
    .person-title-row {
      grid-template-columns: minmax(0, 1fr) 6.5rem;
      gap: 0.9rem;
    }

    .person-title-copy :global(h1) {
      font-size: clamp(1.8rem, 7.5vw, 2.15rem);
      line-height: 1.08;
    }

    .person-portrait {
      margin-top: 0.65rem;
    }

    .person-portrait__mourning-ribbon {
      height: 0.42rem;
    }
  }
</style>
