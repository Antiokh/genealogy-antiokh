---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { getCollection } from 'astro:content';

const route = Astro.locals.starlightRoute;
const isPerson = route.entry.data.entity === 'person' && route.id.startsWith('people/');
const personRef = isPerson ? `${route.id.replace(/^people\//, '').replace(/\/$/, '')}.md` : null;

let portraitEntry;
if (isPerson && route.entry.data.portrait) {
  const portraitStem = String(route.entry.data.portrait).replace(/\.mdx?$/i, '');
  const docs = await getCollection('docs');
  portraitEntry = docs.find((entry) => entry.data.entity === 'media' && entry.id === `media/${portraitStem}`);
}

const portraitImage = portraitEntry?.data.image;
const portraitSrc = typeof portraitImage === 'string'
  ? portraitImage
  : portraitImage && typeof portraitImage === 'object' && 'src' in portraitImage
    ? portraitImage.src
    : route.entry.data.photo;
const portraitWidth = typeof portraitImage === 'object' && portraitImage && 'width' in portraitImage
  ? portraitImage.width
  : portraitEntry?.data.width;
const portraitHeight = typeof portraitImage === 'object' && portraitImage && 'height' in portraitImage
  ? portraitImage.height
  : portraitEntry?.data.height;
const personName = route.entry.data.name;
const personLabel = typeof personName === 'string'
  ? personName
  : personName && typeof personName === 'object'
    ? personName.display || personName.full
    : route.entry.data.title;
const portraitAlt = portraitEntry?.data.alt || personLabel || route.entry.data.title || '';

const subject = portraitEntry?.data.subjects?.find((value) => {
  if (!personRef) return false;
  return typeof value === 'string' ? value === personRef : value.person === personRef;
});
const focal = typeof subject === 'object' ? subject?.focal : undefined;
const objectPosition = focal ? `${focal.x * 100}% ${focal.y * 100}%` : '50% 35%';
---

{isPerson && portraitSrc ? (
  <div class="person-title-row">
    <div class="person-title-copy"><Default /></div>
    <figure class="person-portrait">
      <img
        src={portraitSrc}
        alt={portraitAlt}
        width={portraitWidth}
        height={portraitHeight}
        loading="eager"
        decoding="async"
        style={`object-position:${objectPosition}`}
      />
      {portraitEntry?.data.caption && <figcaption>{portraitEntry.data.caption}</figcaption>}
    </figure>
  </div>
) : (
  <Default />
)}

<style>
  .person-title-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(7rem, 18vw, 10.5rem);
    gap: 1.5rem;
    align-items: start;
  }

  .person-title-copy {
    min-width: 0;
  }

  .person-portrait {
    margin: 0.35rem 0 0;
  }

  .person-portrait img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-6);
    box-shadow: 0 0.2rem 0.8rem color-mix(in srgb, var(--sl-color-black) 12%, transparent);
  }

  .person-portrait figcaption {
    margin-top: 0.35rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    line-height: 1.35;
    text-align: center;
  }

  @media (max-width: 36rem) {
    .person-title-row {
      grid-template-columns: minmax(0, 1fr) 6.5rem;
      gap: 0.9rem;
    }

    .person-portrait {
      margin-top: 0.65rem;
    }
  }
</style>
