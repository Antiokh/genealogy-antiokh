---
import { getCollection } from 'astro:content';
import 'maplibre-gl/dist/maplibre-gl.css';

interface Props {
  personRef: string;
}

const { personRef } = Astro.props;
const docs = await getCollection('docs');

const placeByRef = new Map(
  docs
    .filter((entry) => entry.data.entity === 'place' && entry.id.startsWith('places/'))
    .map((entry) => [`${entry.id.replace(/^places\//, '')}.md`, entry]),
);

const events = docs.filter((entry) => (
  entry.data.entity === 'event'
  && entry.data.timeline !== false
  && entry.data.participants?.includes(personRef)
));

const grouped = new Map<string, {
  ref: string;
  label: string;
  latitude: number;
  longitude: number;
  precision?: string;
  events: string[];
}>();

for (const event of events) {
  for (const ref of event.data.places ?? []) {
    const place = placeByRef.get(ref);
    const geo = place?.data.geo;
    if (!place || !geo) continue;
    const existing = grouped.get(ref) ?? {
      ref,
      label: place.data.label ?? place.data.title ?? ref,
      latitude: geo.latitude,
      longitude: geo.longitude,
      precision: geo.precision,
      events: [],
    };
    existing.events.push(event.data.title);
    grouped.set(ref, existing);
  }
}

const points = [...grouped.values()].sort((a, b) => a.label.localeCompare(b.label, 'ru'));
const mapId = `person-places-${personRef.replace(/[^a-z0-9]+/gi, '-')}`;
---

{points.length > 0 && (
  <section class="person-places" aria-labelledby={`${mapId}-heading`} data-person-places-map data-points={JSON.stringify(points)}>
    <h2 id={`${mapId}-heading`}>Места на карте</h2>
    <p class="map-note">Точки собраны из связанных событий. Координаты с точностью «город» или «регион» являются репрезентативными, а не адресными.</p>
    <div id={mapId} class="person-map-canvas" aria-label="Карта мест, связанных с человеком"></div>
    <noscript>
      <ul>
        {points.map((point) => <li>{point.label}</li>)}
      </ul>
    </noscript>
  </section>
)}

<script>
  type MapTheme = 'dark' | 'light';

  const mapStyleUrls: Record<MapTheme, string> = {
    dark: 'https://tiles.openfreemap.org/styles/fiord',
    light: 'https://openmaptiles.github.io/osm-bright-gl-style/style-cdn.json',
  };

  function readMapTheme(): MapTheme {
    const documentTheme = document.documentElement.dataset.theme;
    if (documentTheme === 'light' || documentTheme === 'dark') return documentTheme;
    return window.matchMedia?.('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
  }

  function collapseAttributionControl(root: HTMLElement) {
    const control = root.querySelector('.maplibregl-ctrl-attrib');
    if (!(control instanceof HTMLElement)) return;

    control.classList.add('maplibregl-compact');
    control.classList.remove('maplibregl-compact-show');
    const button = control.querySelector('.maplibregl-ctrl-attrib-button');
    if (button instanceof HTMLElement) button.setAttribute('aria-expanded', 'false');
  }

  async function initializePersonMaps() {
    const roots = document.querySelectorAll<HTMLElement>('[data-person-places-map]:not([data-map-ready])');
    if (!roots.length) return;

    const { default: maplibregl } = await import('maplibre-gl');

    for (const root of roots) {
      const canvas = root.querySelector<HTMLElement>('.person-map-canvas');
      if (!canvas) continue;
      let points: Array<{ label: string; latitude: number; longitude: number; precision?: string; events: string[] }> = [];
      try {
        points = JSON.parse(root.dataset.points ?? '[]');
      } catch {
        continue;
      }
      if (!points.length) continue;

      let currentTheme = readMapTheme();
      const map = new maplibregl.Map({
        container: canvas,
        style: mapStyleUrls[currentTheme],
        center: [points[0].longitude, points[0].latitude],
        zoom: points.length === 1 ? 8 : 3,
        attributionControl: false,
      });

      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
      map.addControl(new maplibregl.AttributionControl({ compact: true }), 'bottom-right');

      const collapseAttribution = () => collapseAttributionControl(root);
      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(collapseAttribution);
      });

      const bounds = new maplibregl.LngLatBounds();
      for (const point of points) {
        const popupContent = document.createElement('div');
        const title = document.createElement('strong');
        title.textContent = point.label;
        popupContent.append(title);
        if (point.events.length) {
          const list = document.createElement('ul');
          for (const eventTitle of point.events) {
            const item = document.createElement('li');
            item.textContent = eventTitle;
            list.append(item);
          }
          popupContent.append(list);
        }
        new maplibregl.Marker()
          .setLngLat([point.longitude, point.latitude])
          .setPopup(new maplibregl.Popup({ offset: 24 }).setDOMContent(popupContent))
          .addTo(map);
        bounds.extend([point.longitude, point.latitude]);
      }

      map.once('load', () => {
        collapseAttribution();
        if (points.length > 1) {
          map.fitBounds(bounds, { padding: 48, maxZoom: 8, duration: 0 });
        }
      });
      map.once('idle', collapseAttribution);

      const preference = window.matchMedia?.('(prefers-color-scheme: light)');
      const syncTheme = () => {
        const nextTheme = readMapTheme();
        if (nextTheme === currentTheme) return;
        currentTheme = nextTheme;
        map.setStyle(mapStyleUrls[currentTheme]);
        map.once('style.load', collapseAttribution);
      };
      const themeObserver = new MutationObserver(syncTheme);
      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
      preference?.addEventListener('change', syncTheme);

      const cleanup = () => {
        themeObserver.disconnect();
        preference?.removeEventListener('change', syncTheme);
        map.remove();
      };
      document.addEventListener('astro:before-swap', cleanup, { once: true });

      root.dataset.mapReady = 'true';
    }
  }

  void initializePersonMaps();
  document.addEventListener('astro:page-load', () => void initializePersonMaps());
</script>

<style>
  .person-places {
    --map-popup-bg: #ffffff;
    --map-popup-fg: #1f2937;
    --map-panel-border: rgb(148 163 184 / 42%);
    --map-control-bg: #ffffff;
    --map-control-hover: #f1f5f9;
    --map-control-fg: #1f2937;
    --map-control-border: #d7dde4;
    --map-link: #1d4ed8;
    margin-top: 2.75rem;
    color-scheme: light;
  }

  :global(html[data-theme='dark']) .person-places {
    --map-popup-bg: #1f2937;
    --map-popup-fg: #e5e7eb;
    --map-panel-border: rgb(100 116 139 / 50%);
    --map-control-bg: #1f2937;
    --map-control-hover: #334155;
    --map-control-fg: #e5e7eb;
    --map-control-border: #475569;
    --map-link: #93c5fd;
    color-scheme: dark;
  }

  .map-note { color: var(--sl-color-gray-3); font-size: 0.875rem; }

  .person-map-canvas {
    width: 100%;
    height: min(58vh, 34rem);
    min-height: 24rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .person-places :global(.maplibregl-ctrl-group) {
    overflow: hidden;
    border: 1px solid var(--map-control-border);
    border-radius: 0.55rem;
    background: var(--map-control-bg) !important;
    box-shadow: 0 2px 9px rgb(15 23 42 / 16%);
  }

  .person-places :global(.maplibregl-ctrl-group button) {
    background-color: var(--map-control-bg) !important;
    color: var(--map-control-fg) !important;
  }

  .person-places :global(.maplibregl-ctrl-group button:hover),
  .person-places :global(.maplibregl-ctrl-group button:focus-visible) {
    background-color: var(--map-control-hover) !important;
  }

  .person-places :global(.maplibregl-ctrl-group button + button) {
    border-top-color: var(--map-control-border) !important;
  }

  :global(html[data-theme='dark']) .person-places :global(.maplibregl-ctrl-group .maplibregl-ctrl-icon),
  :global(html[data-theme='dark']) .person-places :global(.maplibregl-ctrl-attrib-button) {
    filter: invert(1) brightness(1.35);
  }

  .person-places :global(.maplibregl-ctrl-attrib) {
    border: 1px solid var(--map-control-border);
    background: color-mix(in srgb, var(--map-control-bg) 92%, transparent) !important;
    color: var(--map-control-fg);
    backdrop-filter: blur(8px);
  }

  .person-places :global(.maplibregl-ctrl-attrib a) {
    color: var(--map-link);
  }

  .person-places :global(.maplibregl-ctrl-attrib.maplibregl-compact:not(.maplibregl-compact-show)) {
    min-height: 24px;
    padding: 0;
  }

  .person-places :global(.maplibregl-popup) {
    max-width: min(22rem, 80vw) !important;
  }

  .person-places :global(.maplibregl-popup-content) {
    max-width: 22rem;
    overflow-wrap: anywhere;
    border: 1px solid var(--map-panel-border);
    border-radius: 0.65rem;
    background: var(--map-popup-bg);
    color: var(--map-popup-fg);
    box-shadow: 0 5px 20px rgb(15 23 42 / 24%);
  }

  .person-places :global(.maplibregl-popup-anchor-top .maplibregl-popup-tip),
  .person-places :global(.maplibregl-popup-anchor-top-left .maplibregl-popup-tip),
  .person-places :global(.maplibregl-popup-anchor-top-right .maplibregl-popup-tip) {
    border-bottom-color: var(--map-popup-bg);
  }

  .person-places :global(.maplibregl-popup-anchor-bottom .maplibregl-popup-tip),
  .person-places :global(.maplibregl-popup-anchor-bottom-left .maplibregl-popup-tip),
  .person-places :global(.maplibregl-popup-anchor-bottom-right .maplibregl-popup-tip) {
    border-top-color: var(--map-popup-bg);
  }

  .person-places :global(.maplibregl-popup-anchor-left .maplibregl-popup-tip) {
    border-right-color: var(--map-popup-bg);
  }

  .person-places :global(.maplibregl-popup-anchor-right .maplibregl-popup-tip) {
    border-left-color: var(--map-popup-bg);
  }

  .person-places :global(.maplibregl-popup-close-button) {
    color: var(--map-popup-fg);
  }

  .person-places :global(.maplibregl-popup-content ul) {
    margin: 0.5rem 0 0;
    padding-left: 1.1rem;
  }
</style>
