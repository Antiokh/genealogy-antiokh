---
import { getCollection } from 'astro:content';
import 'maplibre-gl/dist/maplibre-gl.css';
import '../styles/map-popup-shared.css';
import '../styles/map-popup-tail.css';
import '../styles/map-controls.css';
import '../styles/map-year-range.css';

interface Props {
  personRef: string;
}

const { personRef } = Astro.props;
const docs = await getCollection('docs');
const placeRefs = new Set(docs
  .filter((entry) => entry.data.entity === 'place' && Boolean(entry.data.geo))
  .map((entry) => `${entry.id.replace(/^places\//, '')}.md`));
const relatedEvents = docs.filter((entry) => entry.data.entity === 'event'
  && entry.data.timeline !== false
  && entry.data.participants?.includes(personRef));
const relatedRefs = new Set(relatedEvents.map((entry) => `${entry.id.replace(/^events\//, '')}.md`));
const eventByRef = new Map(docs.filter((entry) => entry.data.entity === 'event')
  .map((entry) => [`${entry.id.replace(/^events\//, '')}.md`, entry]));

function hasPhotoSubject(subject: unknown) {
  if (typeof subject === 'string') return subject === personRef;
  return Boolean(subject && typeof subject === 'object' && 'person' in subject
    && (subject as { person: string }).person === personRef);
}

const hasEventPoint = relatedEvents.some((event) => event.data.places?.some((ref) => placeRefs.has(ref)));
const hasPhotoPoint = docs.some((entry) => {
  const data = entry.data;
  if (data.entity !== 'media' || !data.image || data.draft === true || data.public === false) return false;
  if (data.mediaType && data.mediaType !== 'photo') return false;
  if (!data.subjects?.some(hasPhotoSubject) && !data.eventRefs?.some((ref) => relatedRefs.has(ref))) return false;
  if (data.geo || (data.place && placeRefs.has(data.place))) return true;
  if (data.place) return false;
  const inferred = new Set((data.eventRefs ?? []).flatMap((ref) => eventByRef.get(ref)?.data.places ?? []));
  return inferred.size === 1 && placeRefs.has([...inferred][0]);
});
const person = docs.find((entry) =>
  entry.data.entity === 'person' && entry.id === `people/${personRef.replace(/\.mdx?$/i, '')}`,
);
const structuredName = person?.data.name;
const fullName = String(
  typeof structuredName === 'string'
    ? structuredName
    : structuredName?.display || structuredName?.full || person?.data.displayName || person?.data.title || personRef,
).trim();
const mapTitle = `События жизни ${fullName}`;
const mapId = `person-places-${personRef.replace(/[^a-z0-9]+/gi, '-')}`;
---

{(hasEventPoint || hasPhotoPoint) && (
  <section class="person-places" aria-labelledby={`${mapId}-heading`} data-person-places-map data-person-ref={personRef} data-event-refs={JSON.stringify([...relatedRefs])}>
    <h2 id={`${mapId}-heading`}>Места на карте</h2>
    <p class="map-note">Точки собраны из событий и фотографий. Координаты с точностью «город» или «регион» являются репрезентативными, а не адресными.</p>
    <div id={mapId} class="person-map-canvas" aria-label={mapTitle}>
      <div class="genealogy-map-top-panels">
        <div class="genealogy-map-title-tab" data-map-title title={mapTitle}>{mapTitle}</div>
        <div class="event-range" data-range-control hidden aria-label="Фильтр событий и фотографий по годам">
          <output data-range-label>Временной интервал: загрузка…</output>
          <div class="event-range__track" data-range-track>
            <input data-range-from type="range" aria-label="Начальный год" />
            <input data-range-to type="range" aria-label="Конечный год" />
          </div>
        </div>
      </div>
    </div>
    <noscript>Для интерактивной карты требуется JavaScript.</noscript>
  </section>
)}

<script>
  import { createMapPopupContent, createPhotoMarkerElement, groupMapRecords, mountMapLayerSwitch } from '../scripts/map-popup';
  import { MapOverviewControl } from '../scripts/map-controls';
  import { mapEventsInYears, mapPhotosInYears, mountMapYearRange } from '../scripts/map-year-range';

  type MapTheme = 'dark' | 'light';

  const mapStyleUrls: Record<MapTheme, string> = {
    dark: 'https://tiles.openfreemap.org/styles/bright',
    light: 'https://tiles.openfreemap.org/styles/bright',
  };

  function readMapTheme(): MapTheme {
    const documentTheme = document.documentElement.dataset.theme;
    if (documentTheme === 'light' || documentTheme === 'dark') return documentTheme;
    return window.matchMedia?.('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
  }

  function collapseAttributionControl(root: HTMLElement) {
    const control = root.querySelector('.maplibregl-ctrl-attrib');
    if (!(control instanceof HTMLElement)) return;
    control.classList.add('maplibregl-compact');
    control.classList.remove('maplibregl-compact-show');
    const button = control.querySelector('.maplibregl-ctrl-attrib-button');
    if (button instanceof HTMLElement) button.setAttribute('aria-expanded', 'false');
  }

  async function initializePersonMaps() {
    const roots = document.querySelectorAll<HTMLElement>('[data-person-places-map]:not([data-map-ready])');
    if (!roots.length) return;
    const { default: maplibregl } = await import('maplibre-gl');
    const [eventsResult, peopleResult, photosResult] = await Promise.all([
      fetch('/generated/places.geojson'),
      fetch('/generated/people.json'),
      fetch('/events/map-media.json'),
    ]);
    if (!eventsResult.ok || !peopleResult.ok || !photosResult.ok) {
      for (const root of roots) {
        const canvas = root.querySelector<HTMLElement>('.person-map-canvas');
        if (canvas) canvas.textContent = 'Не удалось загрузить данные карты.';
      }
      return;
    }
    const [eventData, peopleData, photoData] = await Promise.all([
      eventsResult.json(), peopleResult.json(), photosResult.json(),
    ]);
    const peopleByRef = new Map((peopleData.people ?? []).map((person: any) => [person.ref, person]));

    for (const root of roots) {
      const canvas = root.querySelector<HTMLElement>('.person-map-canvas');
      if (!canvas) continue;
      const personRef = root.dataset.personRef;
      const rangeControl = canvas.querySelector<HTMLElement>('[data-range-control]');
      if (!rangeControl) continue;
      let eventRefs: string[] = [];
      try {
        eventRefs = JSON.parse(root.dataset.eventRefs ?? '[]');
      } catch {
        continue;
      }
      const eventsForPerson = (eventData.features ?? []).filter((feature: any) =>
        feature.properties?.timeline !== false
        && feature.properties?.participants?.includes(personRef));
      const relevantRefs = new Set(eventRefs);
      const photosForPerson = (photoData.photos ?? []).filter((photo: any) =>
        photo.subjects?.includes(personRef)
        || photo.eventRefs?.some((ref: string) => relevantRefs.has(ref)));

      let layerMode = 'all';
      // One controller per map keeps multiple people on a page independent.
      const yearRange = mountMapYearRange(rangeControl, eventsForPerson, photosForPerson, () => {
        renderMarkers();
      });
      const groups = () => groupMapRecords(
        layerMode === 'photos' ? [] : mapEventsInYears(eventsForPerson, yearRange.selected()),
        layerMode === 'events' ? [] : mapPhotosInYears(photosForPerson, yearRange.selected()),
      );
      const initial = groups();
      if (!initial.length) {
        yearRange.dispose();
        canvas.textContent = 'Нет географически привязанных записей.';
        continue;
      }

      let currentTheme = readMapTheme();
      const map = new maplibregl.Map({
        container: canvas,
        style: mapStyleUrls[currentTheme],
        center: initial[0].coordinates,
        zoom: initial.length === 1 ? 8 : 3,
        attributionControl: false,
      });
      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
      map.addControl(new maplibregl.AttributionControl({ compact: true }), 'bottom-right');

      const markers: maplibregl.Marker[] = [];
      const renderMarkers = () => {
        while (markers.length) markers.pop()?.remove();
        for (const group of groups()) {
          const hasPhotos = group.photos.length > 0;
          markers.push(new maplibregl.Marker(hasPhotos
            ? { element: createPhotoMarkerElement(group), anchor: 'bottom' }
            : undefined)
            .setLngLat(group.coordinates)
            .setPopup(new maplibregl.Popup({
              maxWidth: 'min(22rem, 80vw)',
              offset: hasPhotos ? 22 : 24,
              focusAfterOpen: false,
            }).setDOMContent(createMapPopupContent(group, peopleByRef)))
            .addTo(map));
        }
      };
      const fitOverview = (animate = false) => {
        const points = groups();
        if (!points.length) return;
        if (points.length === 1) {
          map.easeTo({ center: points[0].coordinates, zoom: 8, duration: animate ? 350 : 0 });
          return;
        }
        const bounds = new maplibregl.LngLatBounds();
        for (const point of points) bounds.extend(point.coordinates);
        map.fitBounds(bounds, { padding: 48, maxZoom: 8, duration: animate ? 350 : 0 });
      };
      // The overview fits the currently visible layer (events/photos) without changing filters.
      map.addControl(new MapOverviewControl(() => fitOverview(true), 'Показать все места'), 'top-right');
      map.addControl(new maplibregl.FullscreenControl({ container: canvas }), 'top-right');

      const removeSwitch = mountMapLayerSwitch(canvas, eventsForPerson.length > 0, photosForPerson.length > 0, (next: string) => {
        layerMode = next;
        renderMarkers();
        fitOverview();
      });
      const collapseAttribution = () => collapseAttributionControl(root);
      map.once('load', () => {
        renderMarkers();
        fitOverview();
        collapseAttribution();
      });
      map.once('idle', collapseAttribution);
      window.requestAnimationFrame(() => window.requestAnimationFrame(collapseAttribution));

      const preference = window.matchMedia?.('(prefers-color-scheme: light)');
      const syncTheme = () => {
        const next = readMapTheme();
        if (next === currentTheme) return;
        currentTheme = next;
        map.setStyle(mapStyleUrls[currentTheme]);
        map.once('style.load', collapseAttribution);
      };
      const themeObserver = new MutationObserver(syncTheme);
      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
      preference?.addEventListener('change', syncTheme);

      const cleanup = () => {
        yearRange.dispose();
        themeObserver.disconnect();
        preference?.removeEventListener('change', syncTheme);
        removeSwitch();
        map.remove();
      };
      document.addEventListener('astro:before-swap', cleanup, { once: true });
      root.dataset.mapReady = 'true';
    }
  }

  void initializePersonMaps();
  document.addEventListener('astro:page-load', () => void initializePersonMaps());
</script>

<style>
  .person-places {
    --map-popup-bg: #ffffff;
    --map-popup-fg: #1f2937;
    --map-panel-bg: var(--map-popup-bg);
    --map-panel-fg: var(--map-popup-fg);
    --map-panel-muted: #75604f;
    --map-range-track: #c8b99f;
    --map-range-active: #984a24;
    --map-panel-border: rgb(148 163 184 / 42%);
    --map-control-bg: #ffffff;
    --map-control-hover: #f1f5f9;
    --map-control-fg: #1f2937;
    --map-control-border: #d7dde4;
    --map-link: #1d4ed8;
    margin-top: 2.75rem;
    color-scheme: light;
  }

  :global(html[data-theme='dark']) .person-places {
    --map-popup-bg: #1f2937;
    --map-popup-fg: #e5e7eb;
    --map-panel-muted: #c2aa96;
    --map-range-track: #513726;
    --map-range-active: #c66a32;
    --map-panel-border: rgb(100 116 139 / 50%);
    --map-control-bg: #1f2937;
    --map-control-hover: #334155;
    --map-control-fg: #e5e7eb;
    --map-control-border: #475569;
    --map-link: #93c5fd;
    color-scheme: dark;
  }

  .map-note { color: var(--sl-color-gray-3); font-size: 0.875rem; }

  .person-map-canvas {
    position: relative;
    width: 100%;
    height: min(58vh, 34rem);
    min-height: 24rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .person-places :global(.maplibregl-ctrl-group) {
    overflow: hidden;
    border: 1px solid var(--map-control-border);
    border-radius: 0.55rem;
    background: var(--map-control-bg) !important;
    box-shadow: 0 2px 9px rgb(15 23 42 / 16%);
  }

  .person-places :global(.maplibregl-ctrl-group button) {
    background-color: var(--map-control-bg) !important;
    color: var(--map-control-fg) !important;
  }

  .person-places :global(.maplibregl-ctrl-group button:hover),
  .person-places :global(.maplibregl-ctrl-group button:focus-visible) {
    background-color: var(--map-control-hover) !important;
  }

  .person-places :global(.maplibregl-ctrl-group button + button) {
    border-top-color: var(--map-control-border) !important;
  }

  :global(html[data-theme='dark']) .person-places :global(.maplibregl-ctrl-group .maplibregl-ctrl-icon),
  :global(html[data-theme='dark']) .person-places :global(.maplibregl-ctrl-attrib-button) {
    filter: invert(1) brightness(1.35);
  }

  .person-places :global(.maplibregl-ctrl-attrib) {
    border: 1px solid var(--map-control-border);
    background: color-mix(in srgb, var(--map-control-bg) 92%, transparent) !important;
    color: var(--map-control-fg);
    backdrop-filter: blur(8px);
  }

  .person-places :global(.maplibregl-ctrl-attrib a) {
    color: var(--map-link);
  }

  .person-places :global(.maplibregl-ctrl-attrib.maplibregl-compact:not(.maplibregl-compact-show)) {
    min-height: 24px;
    padding: 0;
  }

  .person-places :global(.maplibregl-popup) {
    max-width: min(22rem, 80vw) !important;
  }

  .person-places :global(.maplibregl-popup-content) {
    max-width: 22rem;
    overflow-wrap: anywhere;
    border: 1px solid var(--map-panel-border);
    border-radius: 0.65rem;
    background: var(--map-popup-bg);
    color: var(--map-popup-fg);
    box-shadow: 0 5px 20px rgb(15 23 42 / 24%);
  }

  .person-places :global(.maplibregl-popup-anchor-top .maplibregl-popup-tip),
  .person-places :global(.maplibregl-popup-anchor-top-left .maplibregl-popup-tip),
  .person-places :global(.maplibregl-popup-anchor-top-right .maplibregl-popup-tip) {
    border-bottom-color: var(--map-popup-bg);
  }

  .person-places :global(.maplibregl-popup-anchor-bottom .maplibregl-popup-tip),
  .person-places :global(.maplibregl-popup-anchor-bottom-left .maplibregl-popup-tip),
  .person-places :global(.maplibregl-popup-anchor-bottom-right .maplibregl-popup-tip) {
    border-top-color: var(--map-popup-bg);
  }

  .person-places :global(.maplibregl-popup-anchor-left .maplibregl-popup-tip) {
    border-right-color: var(--map-popup-bg);
  }

  .person-places :global(.maplibregl-popup-anchor-right .maplibregl-popup-tip) {
    border-left-color: var(--map-popup-bg);
  }

  .person-places :global(.maplibregl-popup-close-button) {
    color: var(--map-popup-fg);
  }

  .person-places :global(.maplibregl-popup-content ul) {
    margin: 0.5rem 0 0;
    padding-left: 1.1rem;
  }
</style>

